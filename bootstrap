#!/usr/bin/env bash
# Fresh-device bootstrap: pull gnupg, password-store, and dotfiles from pauline.
# Usage:
#   ./bootstrap                             # auto-detect via `hostname -s`
#   ./bootstrap <host>                      # {pauline|thinkpad|pixel-7|blackview}
#   ./bootstrap <host> <user@remote|ip>     # override remote (DNS-independent)
#   REMOTE=frf2lr@192.168.178.20 ./bootstrap
#
# If your resolver can't find `pauline` (e.g. you're outside the fritz.box LAN,
# or a search-domain rewrites it to `pauline.fritz.box`), pass an IP or a fully
# qualified hostname as the second argument, or set $REMOTE.
#
# Auth: works with either SSH key or username/password. You will be prompted
# at most once for the remote password; the connection is then reused via
# SSH ControlMaster multiplexing for the three rsync transfers below.
#
# Download:
#   curl -O https://raw.githubusercontent.com/fabianfranzelin/dotfiles/nightly/bootstrap
#   chmod +x bootstrap && ./bootstrap

set -euo pipefail

LOCAL_HOST="${1:-$(hostname -s)}"
REMOTE_USER_DEFAULT="frf2lr"

# Candidate remote hosts, tried in order. Override entirely with $REMOTE
# (a full user@host) or override the list with $REMOTE_HOSTS (space-separated).
REMOTE_HOSTS_DEFAULT=(pauline 192.168.178.48 franzelin.dyndns.org)
if [ -n "${REMOTE_HOSTS:-}" ]; then
    # shellcheck disable=SC2206
    CANDIDATES=($REMOTE_HOSTS)
else
    CANDIDATES=("${REMOTE_HOSTS_DEFAULT[@]}")
fi

# Explicit override via 2nd arg or $REMOTE short-circuits the list.
EXPLICIT_REMOTE="${2:-${REMOTE:-}}"

SSH_PORT="${SSH_PORT:-22}"
PROBE_TIMEOUT="${PROBE_TIMEOUT:-3}"

# A host counts as "reachable" only if we can open a TCP connection to its SSH
# port within $PROBE_TIMEOUT seconds. This covers both DNS resolution AND
# network reachability -- avoiding cases where `getent` succeeds (e.g. via a
# search domain like `pauline.fritz.box`) but ssh then bails out.
resolves() {
    local host="$1"
    timeout "$PROBE_TIMEOUT" bash -c ">/dev/tcp/$host/$SSH_PORT" 2>/dev/null
}

if [ -n "$EXPLICIT_REMOTE" ]; then
    REMOTE="$EXPLICIT_REMOTE"
    REMOTE_HOST="${REMOTE#*@}"
    if ! resolves "$REMOTE_HOST"; then
        echo "bootstrap: '$REMOTE_HOST' is not reachable on port $SSH_PORT (explicit override)." >&2
        exit 1
    fi
else
    REMOTE=""
    for h in "${CANDIDATES[@]}"; do
        if resolves "$h"; then
            REMOTE="$REMOTE_USER_DEFAULT@$h"
            REMOTE_HOST="$h"
            echo "bootstrap: using remote host '$h' (reachable on port $SSH_PORT)."
            break
        else
            echo "bootstrap: '$h' not reachable on port $SSH_PORT; trying next..." >&2
        fi
    done
    if [ -z "$REMOTE" ]; then
        cat >&2 <<EOF
bootstrap: none of the candidate hosts are reachable on port $SSH_PORT:
  ${CANDIDATES[*]}

You may be off the home LAN and without internet DNS/connectivity. Retry with
an explicit address, e.g.:
  ./bootstrap $LOCAL_HOST frf2lr@<ip>
  REMOTE=frf2lr@franzelin.dyndns.org ./bootstrap $LOCAL_HOST

Or add a line to /etc/hosts:
  <ip>  pauline
EOF
        exit 1
    fi
fi

# SSH connection multiplexing: authenticate once, reuse for all rsyncs.
SSH_CTRL_DIR="$(mktemp -d -t bootstrap-ssh.XXXXXX)"
SSH_CTRL="$SSH_CTRL_DIR/ctl-%r@%h:%p"
SSH_OPTS=(-o "ControlMaster=auto"
          -o "ControlPath=$SSH_CTRL"
          -o "ControlPersist=10m"
          -o "PreferredAuthentications=publickey,password,keyboard-interactive")
cleanup_ssh() {
    ssh "${SSH_OPTS[@]}" -O exit "$REMOTE" 2>/dev/null || true
    rm -rf "$SSH_CTRL_DIR"
}
trap cleanup_ssh EXIT

case "$LOCAL_HOST" in
    pauline|thinkpad|blackview) LOCAL_PASS="$HOME/.local/share/password-store" ;;
    pixel-7)                    LOCAL_PASS="$HOME/.password-store" ;;
    *) echo "bootstrap: unknown host '$LOCAL_HOST'" >&2
       echo "usage: $0 {pauline|thinkpad|pixel-7|blackview}" >&2
       exit 1 ;;
esac

REMOTE_PASS=".local/share/password-store"

# 1. Install minimal deps
if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y git gnupg2 openssh-client pass rsync stow
elif command -v pkg >/dev/null 2>&1; then
    pkg install -y git gnupg openssh pass rsync stow
fi

# 2. Authenticate once (opens shared SSH master connection)
echo "Authenticating to $REMOTE (you may be prompted for your password)..."
ssh "${SSH_OPTS[@]}" -Nf "$REMOTE"

RSYNC_RSH="ssh -o ControlPath=$SSH_CTRL"

# 3. GnuPG keys
mkdir -p "$HOME/.gnupg"
rsync -avz -e "$RSYNC_RSH" "$REMOTE:.gnupg/" "$HOME/.gnupg/"
chmod 700 "$HOME/.gnupg"
find "$HOME/.gnupg" -type f -exec chmod 600 {} +

# 4. Password store
mkdir -p "$LOCAL_PASS"
rsync -avz -e "$RSYNC_RSH" "$REMOTE:$REMOTE_PASS/" "$LOCAL_PASS/"

# 5. Dotfiles
mkdir -p "$HOME/workspace/dotfiles"
rsync -avz -e "$RSYNC_RSH" "$REMOTE:workspace/dotfiles/" "$HOME/workspace/dotfiles/"

echo
echo "Bootstrap complete. Next:"
echo "  cd ~/workspace/dotfiles && ./configure -i"
