#!/usr/bin/env bash
# Fresh-device bootstrap: pull gnupg, password-store, and dotfiles from pauline.
# Usage:
#   ./bootstrap                 # auto-detect via `hostname -s`
#   ./bootstrap <host>          # {pauline|thinkpad|pixel-7|blackview}
#
# Download:
#   curl -O https://raw.githubusercontent.com/fabianfranzelin/dotfiles/nightly/bootstrap
#   chmod +x bootstrap && ./bootstrap

set -euo pipefail

REMOTE="${REMOTE:-frf2lr@pauline}"
LOCAL_HOST="${1:-$(hostname -s)}"

case "$LOCAL_HOST" in
    pauline|thinkpad|blackview) LOCAL_PASS="$HOME/.local/share/password-store" ;;
    pixel-7)                    LOCAL_PASS="$HOME/.password-store" ;;
    *) echo "bootstrap: unknown host '$LOCAL_HOST'" >&2
       echo "usage: $0 {pauline|thinkpad|pixel-7|blackview}" >&2
       exit 1 ;;
esac

REMOTE_PASS=".local/share/password-store"

# 1. Install minimal deps
if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y git gnupg2 openssh-client pass rsync stow
elif command -v pkg >/dev/null 2>&1; then
    pkg install -y git gnupg openssh pass rsync stow
fi

# 2. GnuPG keys
mkdir -p "$HOME/.gnupg"
rsync -avz "$REMOTE:.gnupg/" "$HOME/.gnupg/"
chmod 700 "$HOME/.gnupg"
find "$HOME/.gnupg" -type f -exec chmod 600 {} +

# 3. Password store
mkdir -p "$LOCAL_PASS"
rsync -avz "$REMOTE:$REMOTE_PASS/" "$LOCAL_PASS/"

# 4. Dotfiles
mkdir -p "$HOME/workspace/dotfiles"
rsync -avz "$REMOTE:workspace/dotfiles/" "$HOME/workspace/dotfiles/"

echo
echo "Bootstrap complete. Next:"
echo "  cd ~/workspace/dotfiles && ./configure -i"
