#!/usr/bin/env bash
# gh-pr-inbox — Generate a markdown file listing actionable PRs.
#
# Sources:
#   1. Assigned to me (non-draft) — excludes PRs I've currently approved
#   2. Mentions me — excludes PRs I've currently approved
#   3. Stalled approvals — my approval was dismissed and I haven't re-approved
#
# Usage:
#   gh-pr-inbox [--user USER] [--repo OWNER/REPO] [--limit N] [--output FILE]
#
# Requires: gh (GitHub CLI), jq

set -euo pipefail

USER="@me"
REPO=""
LIMIT=100
OUTPUT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --user)  USER="$2"; shift 2 ;;
        --repo)  REPO="$2"; shift 2 ;;
        --limit) LIMIT="$2"; shift 2 ;;
        --output) OUTPUT="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,/^$/s/^# //p' "$0"
            exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# Cap GraphQL first at 100
GQL_LIMIT=$((LIMIT > 100 ? 100 : LIMIT))

repo_filter=""
[[ -n "$REPO" ]] && repo_filter=" repo:$REPO"

###############################################################################
# Single GraphQL query fetching all data
###############################################################################

QUERY="{
  viewer { login }
  assigned: search(query:\"is:pr is:open assignee:${USER} -is:draft sort:updated${repo_filter}\", type:ISSUE, first:${GQL_LIMIT}) {
    nodes { ...on PullRequest {
      number repository { nameWithOwner } title state updatedAt url
      author { login } labels(first:10) { nodes { name } }
      comments { totalCount }
      latestReviews(first:50) { nodes { author { login } state } }
    }}
  }
  mentions: search(query:\"is:pr is:open mentions:${USER} sort:updated${repo_filter}\", type:ISSUE, first:${GQL_LIMIT}) {
    nodes { ...on PullRequest {
      number repository { nameWithOwner } title state updatedAt url
      author { login } labels(first:10) { nodes { name } }
      comments { totalCount }
      latestReviews(first:50) { nodes { author { login } state } }
    }}
  }
  stalled: search(query:\"is:pr is:open reviewed-by:${USER} -is:draft -author:${USER} sort:updated${repo_filter}\", type:ISSUE, first:${GQL_LIMIT}) {
    nodes { ...on PullRequest {
      number repository { nameWithOwner } title state updatedAt url
      author { login } labels(first:10) { nodes { name } }
      comments { totalCount }
      reviews(first:100) { nodes { author { login } state submittedAt } }
    }}
  }
}"

RAW=$(gh api graphql -f query="$QUERY")

LOGIN=$(echo "$RAW" | jq -r '.data.viewer.login')
if [[ "$USER" == "@me" ]]; then
    DISPLAY_USER="$LOGIN"
else
    DISPLAY_USER="$USER"
fi

###############################################################################
# Filter assigned: exclude PRs where user's latest review is APPROVED
###############################################################################

assigned_filtered=$(echo "$RAW" | jq -c --arg login "$LOGIN" '
    [.data.assigned.nodes[] |
     select(.latestReviews.nodes | map(select(.author.login == $login and .state == "APPROVED")) | length == 0)]
')

###############################################################################
# Filter mentions: exclude PRs where user's latest review is APPROVED
###############################################################################

mentions_filtered=$(echo "$RAW" | jq -c --arg login "$LOGIN" '
    [.data.mentions.nodes[] |
     select(.latestReviews.nodes | map(select(.author.login == $login and .state == "APPROVED")) | length == 0)]
')

###############################################################################
# Filter stalled: keep PRs where user has DISMISSED review with no later APPROVED
###############################################################################

stalled_filtered=$(echo "$RAW" | jq -c --arg login "$LOGIN" '
    [.data.stalled.nodes[] |
     {pr: ., userReviews: [.reviews.nodes[] | select(.author.login == $login)]} |
     select([.userReviews[] | select(.state == "DISMISSED")] | length > 0) |
     {pr: .pr,
      lastDismissed: ([.userReviews[] | select(.state == "DISMISSED") | .submittedAt] | max),
      lastApproved: ([.userReviews[] | select(.state == "APPROVED") | .submittedAt] | max // "")} |
     select(.lastApproved == "" or .lastApproved < .lastDismissed) |
     .pr]
')

###############################################################################
# Render markdown
###############################################################################

render_section() {
    local title="$1"
    local json="$2"
    local count
    count=$(echo "$json" | jq 'length')

    echo "## ${title} (${count})"
    echo ""

    if [[ "$count" -eq 0 ]]; then
        echo "_None_"
        echo ""
        return
    fi

    echo "| # | Repository | Title | Author | Updated | Comments | URL |"
    echo "|---|-----------|-------|--------|---------|----------|-----|"

    echo "$json" | jq -r '
        sort_by(.updatedAt) | reverse | .[] |
        "| #\(.number) | \(.repository.nameWithOwner) | \(.title) | @\(.author.login) | \(.updatedAt[:10]) | \(.comments.totalCount) | \(.url) |"
    '
    echo ""
}

{
    echo "# PR Inbox for ${DISPLAY_USER}"
    echo ""
    echo "_Generated: $(date -u '+%Y-%m-%d %H:%M UTC')_"
    echo ""

    render_section "Assigned to me (non-draft)" "$assigned_filtered"
    render_section "Mentions me" "$mentions_filtered"
    render_section "Stalled approvals" "$stalled_filtered"
} | if [[ -n "$OUTPUT" ]]; then
    tee "$OUTPUT"
    echo "" >&2
    echo "Written to ${OUTPUT}" >&2
else
    cat
fi
