#!/usr/bin/env bash

for id in id_ed255195; do
    PRIVATE_KEY="${HOME}/.ssh/${id}"
    PUBLIC_KEY="${HOME}/.ssh/${id}.pub"
    PASS_SCRIPT="${HOME}/.ssh/${id}_pass"
    pass "Keys/${id}/key" > "${PRIVATE_KEY}"
    chmod 600 "${PRIVATE_KEY}"
    pass "Keys/${id}/pub" > "${PUBLIC_KEY}"
    chmod 644 "${PUBLIC_KEY}"
    echo "#!/bin/bash
pass Keys/${id}/password" > "${PASS_SCRIPT}"
    chmod +x "${PASS_SCRIPT}"
    SSH_ASKPASS="${PASS_SCRIPT}" ssh-add "${PRIVATE_KEY}" < /dev/null
done
