#!/usr/bin/env bash

IDS=""

if [ "$(hostname)" = "ABT-C-002NY" ]
then
    IDS="id_rsa id_ed25519"
fi

if [ "$(hostname)" = "thinkpad" ] || [ "$(hostname)" = "pauline" ]
then
    IDS="id_ed25519 github_finances"
fi

# Restart ssh agent
pkill -9 ssh-agent && eval $(ssh-agent -s)

# Add keys
for id in ${IDS}; do
    PRIVATE_KEY="${HOME}/.ssh/${id}"
    PUBLIC_KEY="${HOME}/.ssh/${id}.pub"
    PASS_SCRIPT="${HOME}/.ssh/${id}_pass"
    touch "${PRIVATE_KEY}"
    chmod 600 "${PRIVATE_KEY}"
    pass "keys/${id}/key" > "${PRIVATE_KEY}"
    touch "${PUBLIC_KEY}"
    chmod 644 "${PUBLIC_KEY}"
    pass "keys/${id}/pub" > "${PUBLIC_KEY}"
    echo "#!/bin/bash
pass keys/${id}/password" > "${PASS_SCRIPT}"
    chmod +x "${PASS_SCRIPT}"
    DISPLAY=None SSH_ASKPASS="${PASS_SCRIPT}" ssh-add "${PRIVATE_KEY}" < /dev/null
    rm -f "${PASS_SCRIPT}"
done

# Copy ID to pauline
if [ "$(hostname)" = "thinkpad" ]
then
    ssh-copy-id -f -i "${HOME}/.ssh/id_ed25519" frf2lr@pauline
fi
