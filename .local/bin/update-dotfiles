#!/usr/bin/env bash

export DOTFILES
DOTFILES="$(realpath "$(dirname "$(readlink -f "$0")")/../..")"

(
    # Navigate to the directory of this script (generally ~/workspace/dotfiles)
    cd "${DOTFILES}" || exit 1

    # Make sure any running Emacs instance gets updated settings
    emacsclient -e '(load-file "~/.emacs")' -a "echo 'Emacs is not currently running'"

    # Update configuration symlinks
    stow . -t "${HOME}"
)
