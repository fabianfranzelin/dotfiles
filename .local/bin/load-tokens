#!/usr/bin/env sh

#------------------------------------------------------------------------------#
# AOS
export BOSCH_USER
BOSCH_USER="$(pass email/bosch)"
export CONAN_LOGIN_USERNAME
CONAN_LOGIN_USERNAME="${BOSCH_USER}"
export CONAN_PASSWORD
CONAN_PASSWORD="$(pass tokens/${BOSCH_USER}@jfrog.ad-alliance.biz)"
export NPM_TOKEN
NPM_TOKEN="$(pass tokens/$(pass usernames/bosch)@$(hostname).npm.rb-artifactory.bosch.com)"

#------------------------------------------------------------------------------#
# PJ-Rec
export ARTIFACTORY_USER
ARTIFACTORY_USER="$(pass usernames/bosch)"
export ARTIFACTORY_KEY
ARTIFACTORY_KEY="$(pass tokens/${ARTIFACTORY_USER}@artifactory.boschdevcloud.com)"
export ARTIFACTORY_KEY_RB
ARTIFACTORY_KEY_RB="(pass tokens/(pass usernames/bosch)@rb-artifactory.bosch.com)"

#------------------------------------------------------------------------------#
# One-parking
export ARTIFACTORY_API_KEY
ARTIFACTORY_API_KEY="${ARTIFACTORY_KEY_RB}"
export BDC_428_ARTIFACTORY_API_KEY
BDC_428_ARTIFACTORY_API_KEY="${ARTIFACTORY_KEY}"

#------------------------------------------------------------------------------#
# authentication and tokens
if command -v kinit > /dev/null
then
    pass "passwords/$(pass usernames/bosch)@nt" | kinit > /dev/null
fi
