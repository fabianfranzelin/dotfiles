#!/usr/bin/env bash

# shellcheck disable=SC1090,SC1091,SC3001

# set as a default for configurations
. "${HOME}/.profile"

QTILE_PYTHON_FILEPATH="${HOME}/.cache/qtile/python/bin/python3"
QTILE_BIN_FILEPATH="${HOME}/.cache/qtile/python/bin/qtile"
${QTILE_PYTHON_FILEPATH} ${QTILE_BIN_FILEPATH} start -c "${HOME}/.config/qtile/config.py"
