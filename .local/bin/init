#!/usr/bin/env sh

# shellcheck disable=SC1090

set_keyboard_layout()
{
    setxkbmap -layout de -option ctrl:nocaps
}

unlock_key()
{
    # make pinentry aware of the current TTY (useful if using a terminal pinentry)
    export GPG_TTY=$(tty 2>/dev/null || true)

    # sign a small dummy string; output discarded. This will trigger pinentry.
    printf 'unlock\n' | gpg --clearsign --output /dev/null
}

set_keyboard_layout
unlock_key

# initialize default setup according to the available wifis
AVAILABLE_WIFIS=$(nmcli dev wifi list)
AT_HOME=$(echo "${AVAILABLE_WIFIS}" | grep -q "Pauline" && echo "yes" || echo "no")
AT_OFFICE=$(echo "${AVAILABLE_WIFIS}" | grep -q "BWSOA" && echo "yes" || echo "no")
AT_GOTTENHEIM=$(echo "${AVAILABLE_WIFIS}" | grep -q "Tomate" && echo "yes" || echo "no")

if [ "${AT_GOTTENHEIM}" = "yes" ]
then
    autorandr --load gottenheim
elif [ "${AT_HOME}" = "yes" ]
then
    autorandr --load pauline
elif [ "${AT_OFFICE}" = "yes" ]
then
    autorandr --load feuerbach
fi

if [ "$(hostname)" = "FEWI-C-0007J" ] && [ "${AT_OFFICE}" = "no" ]
then
    osd-vpn-connect -k
fi
