#!/usr/bin/env bash

# shellcheck disable=SC1090

# Sync dotfiles repo and ensure that dotfiles are tangled correctly
# afterward

export DOTFILES
DOTFILES="$(realpath "$(dirname "$(readlink -f "$0")")/../..")"
export __SHELL_LIB
__SHELL_LIB="${DOTFILES}/.local/bin/shell"

. "${__SHELL_LIB}/formatting.sh"

(
    # Navigate to the directory of this script (generally ~/workspace/dotfiles)
    cd "${DOTFILES}" || exit 1

    echo
    echo -e "${__COLOR_INFO}Saving Org buffers if Emacs is running...${__COLOR_RESET}"
    emacsclient -u -e "(org-save-all-org-buffers)" -a "echo 'Emacs is not currently running'"

    echo -e "${__COLOR_INFO}Stashing existing changes...${__COLOR_RESET}"
    stash_result=$(git stash push -m "sync-dotfiles: Before syncing dotfiles")
    needs_pop=1
    if [ "$stash_result" = "No local changes to save" ]; then
        needs_pop=0
    fi

    echo -e "${__COLOR_INFO}Pulling updates from dotfiles repo...${__COLOR_RESET}"
    echo
    git pull origin gnu-stow
    echo

    if [ $needs_pop -eq 1 ]; then
        echo -e "${__COLOR_INFO}Popping stashed changes...${__COLOR_RESET}"
        echo
        git stash pop
    fi

    unmerged_files=$(git diff --name-only --diff-filter=U)
    if [ -n "$unmerged_files" ]; then
        echo -e "${__COLOR_ERROR}The following files have merge conflicts after popping the stash:${__COLOR_RESET}"
        echo
        printf %"s\n" "$unmerged_files"  # Ensure newlines are printed
    else
        update-dotfiles
    fi

)
