#!/usr/bin/env bash

# shellcheck disable=SC1090

USERNAME="frf2lr"
HOSTNAME="pauline"

# List of packages with specific versions
hard_drives=(
    "TOSHIBA EXT"
    "My Passport"
)

# Iterate over the list and install each package
for drive in "${hard_drives[@]}"; do
    sshfs "${USERNAME}@${HOSTNAME}:/media/frf2lr/${drive}" "/media/frf2lr/${drive}" -d &
done
