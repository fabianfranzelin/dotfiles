#!/usr/bin/env bash

# shellcheck disable=SC1090

#------------------------------------------------------------------------------#
# description of cmdline-parser

usage="
USAGE
    ${0} [OPTION]...

DESCRIPTION
       Creates the custom folder and uses drafts for non-existing files.
       The whole script is interactive and no file will be removed without permission.

       -h --help
              Print this help message
       -i --install
              Install third-party dependencies
"

#------------------------------------------------------------------------------#
# check prerequisites

# exit as soon as error occurs
set -e

export DOTFILES
DOTFILES=$(git rev-parse --show-toplevel)
export __SHELL_LIB
__SHELL_LIB="${DOTFILES}/.config/shell"

. "${__SHELL_LIB}/formatting.sh"
. "${__SHELL_LIB}/faq.sh"

#------------------------------------------------------------------------------#
# cmdline-parser

while [ "${#}" -gt 0 ]; do
    case "${1}" in
    '-h'|'--help')
        __ERRCODE=0
        ;;
    '-i'|'--install')
        echo -e "${__COLOR_INFO}Install third-party dependencies${__COLOR_RESET}"
        INSTALL_DEPENDENCIES=1
        shift # past argument
        ;;
    *)
        echo -e "${__COLOR_ERR}Unknown value ${1}${__COLOR_RESET}"
        __ERRCODE=1
        ;;
    esac

    if [ -n "${__ERRCODE}" ]; then
        echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
        exit ${__ERRCODE}
    fi
done

#------------------------------------------------------------------------------#
# install required packages

if [ -n "${INSTALL_DEPENDENCIES}" ]; then
    echo -e "${__COLOR_INFO}INFO: Installing minimal required packages for setup...${__COLOR_RESET}"
    sudo apt update && sudo apt-get install python3-pip

    # Remove PyQt5 if installed via pip. This package is buggy. It is
    # installed afterwards again via Ubuntu package sources.
    # python3 -m pip uninstall PyQt5

    # Make sure that there is just one venv package installed. We do
    # this via pip
    sudo apt remove python3-venv -y

    # Update python setuptools to latest release from pypi
    python3 -m pip install --upgrade \
            setuptools \
            pip \
            wheel

    sudo apt install -y \
         xclip \
         apt-transport-https \
         python3-pyqt5 \
         zsh \
         direnv \
         gnome-keyring \
         openjdk-17-jdk \
         zip \
         unzip \
         stow \
         compton \
         nitrogen \
         dmenu \
         rofi \
         vim

    # install dependencies for emacs
    sudo apt install -y \
         markdown \
         pandoc \
         graphviz \
         fonts-cantarell \
         cmake \
         libtool-bin \
         aspell aspell-de aspell-en \
         clang-format \
         clang-tidy \
         clangd \
         clang \
         ripgrep \
         fd-find \
         ccls \
         shellcheck

    # emacs pdf-tools dependencies
    sudo apt install -y \
         libpng-dev \
	     zlib1g-dev \
         libpoppler-glib-dev \
         libpoppler-private-dev \
         imagemagick

    # additional python dependencies
    python3 -m pip install --upgrade \
            virtualenv \
            epc \
            "ptvsd==4.2" \
            black \
            isort \
            yamllint \
            mdformat \
            cmake_language_server \
            "python-lsp-server[all]"

    #------------------------------------------------------------------------------#
    # install dependencies for vscode
    sudo apt install code

    ## fill in custom extensions here
    ## '--force' for updating
    ## 'code --disable-extensions' would disable installed extensions

    ## editor utils
    code --force --install-extension davidhouchin.whitespace-plus
    code --force --install-extension pnp.polacode

    ## git
    code --force --install-extension donjayamanne.githistory

    ## markdown
    code --force --install-extension davidanson.vscode-markdownlint

    ## toml
    code --force --install-extension bungcip.better-toml
    ## csv
    code --force --install-extension mechatroner.rainbow-csv
    ## yaml
    code --force --install-extension redhat.vscode-yaml
    ## shell
    code --force --install-extension timonwong.shellcheck
    ## python
    code --force --install-extension kevinrose.vsc-python-indent
    code --force --install-extension ms-python.python
    ## C/C++
    code --force --install-extension ms-vscode.cpptools
    code --force --install-extension twxs.cmake

    if ( __is_linux ) then
       # try to install snap dependencies. Note that this is not working
       # for Docker or WSL.
       echo -e "${__COLOR_INFO}INFO: Install GTK tools${__COLOR_RESET}"

       # Quickfix required here: Apt is not the best way to install npm
       sudo apt install -y \
            npm
       sudo apt remove -y \
            nodejs

       sudo npm install -g n
       sudo n stable
       sudo npm install npm@latest
       sudo npm install nodejs@latest

       # Install Qtile window manager
       python3 -m pip install --upgrade xcffib
       python3 -m pip install --upgrade --no-cache-dir cairocffi
       sudo apt install -y libpangocairo-1.0-0
       python3 -m pip install --upgrade qtile

       # Create xsessions entry for qtile according to
       # https://docs.qtile.org/en/latest/manual/install/index.html#starting-qtile
       QTILE_DESKTOP_FILE_PATH="/usr/share/xsessions/qtile.desktop"
       if [ ! -f "${QTILE_DESKTOP_FILE_PATH}" ]; then
           echo "[Desktop Entry]
Name=Qtile
Comment=Qtile Session
Exec=qtile start
Type=Application
Keywords=wm;tiling" | sudo tee "${QTILE_DESKTOP_FILE_PATH}"
       else
           echo -e "${__COLOR_ERR}The file '${QTILE_DESKTOP_FILE_PATH}' already exists. Skip creation. ${__COLOR_RESET}"
       fi

       CUSTOM_DESKTOP_FILE_PATH="/usr/share/xsessions/custom.desktop"
       if [ ! -f "${CUSTOM_DESKTOP_FILE_PATH}" ]; then
           echo "[Desktop Entry]
Name=Qtile
Comment=Qtile Session
Exec=/etc/X11/Xsession
Type=Application
Keywords=wm;tiling" | sudo tee "${CUSTOM_DESKTOP_FILE_PATH}"
       else
           echo -e "${__COLOR_ERR}The file '${CUSTOM_DESKTOP_FILE_PATH}' already exists. Skip creation. ${__COLOR_RESET}"
       fi

       sudo apt install -y \
            vlc \
            firefox \
            eog
    else
       echo -e "${__COLOR_INFO}INFO: Skip installing GTK tools since we are running in WSL or Docker.${__COLOR_RESET}"
    fi
fi

#------------------------------------------------------------------------------#
# install oh-my-zsh if required
export ZSH="${HOME}/.cache/oh-my-zsh"
if [[ ! -f "${ZSH}/oh-my-zsh.sh" ]]; then
    sh -c "$(wget -O- https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    # This script creates a .zshrc file in your home directory. We
    # won't need it, since we have a preconfigured one in this repo
    rm "${HOME}/.zshrc"
fi

POWERLEVEL10K_HOME=${ZSH}/custom/themes/powerlevel10k
if [[ ! -d "${POWERLEVEL10K_HOME}" ]]; then
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${POWERLEVEL10K_HOME}"
fi

ZSH_AUTOSUGGESTION_HOME=${ZSH}/custom/plugins/zsh-autosuggestions
if [[ ! -d "${ZSH_AUTOSUGGESTION_HOME}" ]]; then
    git clone https://github.com/zsh-users/zsh-autosuggestions "${ZSH_AUTOSUGGESTION_HOME}"
fi

ZSH_SYNTAX_HIGHLIGHTING=${ZSH}/custom/plugins/zsh-syntax-highlighting
if [[ ! -d "${ZSH_SYNTAX_HIGHLIGHTING}" ]]; then
    git clone https://github.com/zsh-users/zsh-syntax-highlighting "${ZSH_SYNTAX_HIGHLIGHTING}"
fi

ZSH_YOU_SHOULD_USE=${ZSH}/custom/plugins/you-should-use
if [[ ! -d "${ZSH_YOU_SHOULD_USE}" ]]; then
    git clone https://github.com/MichaelAquilina/zsh-you-should-use "${ZSH_YOU_SHOULD_USE}"
fi

#------------------------------------------------------------------------------#
# Hack: setup workstation specific config for git using extra symlink
(
    cd "${DOTFILES}/.config/git"
    TARGET_GIT_CONFIG="config.$(hostname)"
    if [ -f "${TARGET_GIT_CONFIG}" ]; then
        ln -s -f "${TARGET_GIT_CONFIG}" "config.workstation"
    else
        echo -e "${__COLOR_ERR}Missing git configuration for $(hostname). Provide \"$(pwd)/${TARGET_GIT_CONFIG}\"${__COLOR_RESET}"
        exit 1
    fi
)

#------------------------------------------------------------------------------#
# Hack: setup workstation specific config for npm using extra symlink
(
    cd "${DOTFILES}"
    TARGET_NPM_CONFIG=".config/npm/npmrc.$(hostname)"
    if [ -f "${TARGET_NPM_CONFIG}" ]; then
        ln -s -f "${TARGET_NPM_CONFIG}" ".npmrc"
    else
        echo -e "${__COLOR_ERR}Missing npm configuration for $(hostname). Provide \"${DOTFILES}/${TARGET_NPM_CONFIG}\"${__COLOR_RESET}"
        exit 1
    fi
)

#------------------------------------------------------------------------------#
# Setup all symlinks with GNU stow
echo -e "${__COLOR_INFO}INFO: Setup symlinks with GNU stow.${__COLOR_RESET}"

(
    cd "${DOTFILES}"
    stow . -t "${HOME}"
)

