#!/usr/bin/env bash

# shellcheck disable=SC1090,SC1091

#------------------------------------------------------------------------------#
# description of cmdline-parser
usage="
USAGE
    ${0} [OPTION]...

DESCRIPTION
       Configures and installs the system.

       -h --help
              Print this help message
       -i --install-all
              Install all third-party dependencies
       --skip-stow
              Skip stowing links
       --install-base
              Install base packages
       --skip-base
              Skip base installation
       --install-npm
              Install npm packages
       --skip-npm
              Skip npm installation
       --install-zsh
              Install ZSH
       --skip-zsh
              Skip ZSH installation
       --install-emacs
              Install Emacs
       --skip-emacs
              Skip Emacs installation
       --install-docker
              Install Docker
       --skip-docker
              Skip Docker installation
       --install-qtile
              Install Qtile
       --skip-qtile
              Skip Qtile installation
       --install-nyxt
              Install nyxt
       --skip-nyxt
              Skip nyxt installation
"

#------------------------------------------------------------------------------#
# check prerequisites

# exit as soon as error occurs
set -e

export DOTFILES
DOTFILES=$(git rev-parse --show-toplevel)
export __SHELL_LIB
__SHELL_LIB="${DOTFILES}/.config/shell"

. "${__SHELL_LIB}/formatting.sh"
. "${__SHELL_LIB}/faq.sh"

#------------------------------------------------------------------------------#
# make sure that default environment variables are set correctly

export LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}

#------------------------------------------------------------------------------#
# cmdline-parser

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        '-h'|'--help')
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 0
            ;;
        '-i'|'--install-all')
            INSTALL_ALL=1
            shift # past argument
            ;;
        '--skip-stow')
            SKIP_STOW=1
            shift # past argument
            ;;
        '--install-base')
            INSTALL_BASE=1
            shift # past argument
            ;;
        '--skip-base')
            SKIP_BASE=1
            shift # past argument
            ;;
        '--install-npm')
            INSTALL_NPM=1
            shift # past argument
            ;;
        '--skip-npm')
            SKIP_NPM=1
            shift # past argument
            ;;
        '--install-emacs')
            INSTALL_EMACS=1
            shift # past argument
            ;;
        '--skip-emacs')
            SKIP_EMACS=1
            shift # past argument
            ;;
        '--install-docker')
            INSTALL_DOCKER=1
            shift # past argument
            ;;
        '--skip-docker')
            SKIP_DOCKER=1
            shift # past argument
            ;;
        '--install-qtile')
            INSTALL_QTILE=1
            shift # past argument
            ;;
        '--skip-qtile')
            SKIP_QTILE=1
            shift # past argument
            ;;
        '--install-nyxt')
            INSTALL_NYXT=1
            shift # past argument
            ;;
        '--skip-nyxt')
            SKIP_NYXT=1
            shift # past argument
            ;;
        '--install-zsh')
            INSTALL_ZSH=1
            shift # past argument
            ;;
        '--skip-zsh')
            SKIP_ZSH=1
            shift # past argument
            ;;
        *)
            echo -e "${__COLOR_ERR}Unknown value ${1}${__COLOR_RESET}"
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 1
            ;;
    esac
done

#------------------------------------------------------------------------------#
# install required packages
install_base() {
    echo -e "${__COLOR_INFO}INFO: Installing minimal required packages for setup...${__COLOR_RESET}"
    sudo apt-get install -y \
         python3-pip

    # Remove PyQt5 if installed via pip. This package is buggy. It is
    # installed afterwards again via Ubuntu package sources.
    # python3 -m pip uninstall PyQt5

    # Make sure that there is just one venv package installed. We do
    # this via pip
    sudo apt-get remove -y python3-venv

    # Update python setuptools to latest release from pypi
    python3 -m pip install --upgrade \
            pip \
            wheel \
	    setuptools

    sudo apt-get install -y \
         xclip \
         xsel \
         wl-clipboard \
         locate \
         apt-transport-https \
         python3-pyqt5 \
         zsh \
         direnv \
         gnome-keyring \
         openjdk-17-jdk \
         zip \
         wget \
         unzip \
         compton \
         nitrogen \
         dmenu \
         vim \
         ccache \
         gnuplot \
         pass \
         gnupg \
         terminator \
	 fzf \
         htop \
         ssh \
         sshpass \
         dos2unix \
	 openssl \
	 libssl-dev \
         scons \
         texlive-base \
         texlive-science \
         texlive-bibtex-extra \
         texlive-lang-german \
         texlive-luatex \
         biber \
         doxygen \
         evince \
         gcovr

    if ( __is_wsl )
    then
       # install wslview for xdg-open so that firefox calls are
       # forwarded to host system
       sudo apt-get install -y \
            wslu
    fi

    # install gtk tools
    if ( __is_linux )
    then
        sudo apt-get install -y \
             vlc \
             firefox \
             eog
    fi

    # additional python dependencies
    python3 -m pip install --upgrade \
            virtualenv \
            ptvsd \
            black \
            isort \
            yamllint \
            mdformat \
            cmake \
            cmake_language_server \
            "python-lsp-server[all]" \
            pylsp-mypy \
            python-lsp-black \
            esbonio==0.16.4 \
            robotframework-tidy \
            ipython \
            gitpython \
            pytest \
            jupyter

    # install pandoc
    PANDOC_VER="3.1.12.3"
    PANDOC_BIN="pandoc-${PANDOC_VER}-1-amd64.deb"
    PANDOC_URL="https://github.com/jgm/pandoc/releases/download/${PANDOC_VER}/${PANDOC_BIN}"
    (
        cd "/tmp"
        wget "${PANDOC_URL}"
        sudo dpkg -i "${PANDOC_BIN}"
    )

    #------------------------------------------------------------------------------#
    # install dependencies gdb
    (
        cd "/tmp"
        GLIBC_NAME="glibc-2.39"
        wget "https://ftp.gnu.org/gnu/libc/${GLIBC_NAME}.tar.gz"
        tar -zxf "${GLIBC_NAME}.tar.gz"
        mv -n "${GLIBC_NAME}" "${HOME}/.local/share"
    )

    #------------------------------------------------------------------------------#
    # install dependencies for vscode
    if ( __is_linux )
    then
        # note that vscode is mounted from Windows in WSL and not
        # installed via apt. Ignore when code cannot be found
        sudo apt-get install -y code || true
        if command -v snap > /dev/null
        then
            sudo snap install --classic code || true
        fi
    fi
}

install_npm()
{
    # additional npm dependencies
    echo "Install npm dependencies via nvm"
    NVM_VERSION="0.39.7"
    export NVM_DIR="${HOME}/.config/nvm"
    if [ ! -d "${NVM_DIR}" ]
    then
        # use nvm to install node, npm, etc. See
        # https://github.com/nvm-sh/nvm for details.
        echo "Downloading and installing nvm v${NVM_VERSION}"
        wget -qO- https://raw.githubusercontent.com/nvm-sh/nvm/v${NVM_VERSION}/install.sh | bash
    fi

    # load nvm paths
    if [ -s "${NVM_DIR}/nvm.sh" ]
    then
        # An error might occur here, that we can ignore
        . "${NVM_DIR}/nvm.sh" || true
    fi

    if ! command -v nvm &> /dev/null
    then
        echo "Something went wrong with the installation nvm. Please check 'https://github.com/nvm-sh/nvm' for details.."
    fi

    # install npm v16 as default
    NPM_VERSION=18
    echo "Install npm v${NPM_VERSION}"
    nvm install ${NPM_VERSION}
    nvm use ${NPM_VERSION}

    # install lsp servers, linters, etc.
    if ! command -v npm &> /dev/null
    then
        echo "Something went wrong with the installation of npm via nvm. Please call 'nvm install 18 && nvm use 18' manually."
    fi

    npm install -g \
        yaml-language-server \
        bash-language-server \
        typescript \
        typescript-language-server \
        dockerfile-language-server-nodejs \
        jsonlint \
        vscode-langservers-extracted \
        prettier-json \
        eslint

    # install other npm packages
    npm install -g \
        yarn

    #------------------------------------------------------------------------------#
    # Hack: setup workstation specific config for npm using extra symlink
    (
        cd "${DOTFILES}/.config/npm"
        TARGET_NPM_CONFIG="npmrc.$(hostname)"
        if [ -f "${TARGET_NPM_CONFIG}" ]; then
            ln -s -f "${TARGET_NPM_CONFIG}" "npmrc"
        else
            echo -e "${__COLOR_INFO}No specific npm configuration for $(hostname) available. Using the default one.${__COLOR_RESET}"
            ln -s -f "npmrc.default" "npmrc"
        fi
    )
}

install_emacs()
{
    # install Emacs. First, just the regular version.
    if ! command -v emacs &> /dev/null
    then
        echo "Install default Emacs from package sources."
        sudo apt-get install -y \
             emacs
    fi

    # ---------------------------------------------------------
    # install dependencies for Emacs
    sudo apt-get install -y \
         markdown \
         graphviz \
         fonts-cantarell \
         cmake \
         libtool-bin \
         aspell \
         aspell-de \
         aspell-en \
         aspell-es \
         clang-format \
         clang-tidy \
         clangd \
         clangd-12 \
         clang \
         clang-12 \
         valgrind \
         ripgrep \
         fd-find \
         shellcheck \
         poppler-utils \
         mpv

    # emacs pdf-tools dependencies
    sudo apt-get install -y \
         libpng-dev \
	 zlib1g-dev \
         libpoppler-glib-dev \
         libpoppler-private-dev \
         imagemagick

    (
        # now, install the newest version available by building and
        # installing it manually
        cd "${DOTFILES}/.config/emacs" || exit 1
        # This creates the install script for Emacs
        emacs -Q --batch \
              --eval "(require 'org)" \
              --eval '(org-babel-tangle-file "README.org")'
        # Actually install Emacs via update-alternatives
        ./install.sh || exit 1
    )
}

install_git()
{
    sudo apt-get install -y \
         git \
         git-lfs

    #------------------------------------------------------------------------------#
    # Hack: setup workstation specific config for git using extra symlink
    (
        cd "${DOTFILES}/.config/git"
        TARGET_GIT_CONFIG="config.$(hostname)"
        if [ -f "${TARGET_GIT_CONFIG}" ]; then
            ln -s -f "${TARGET_GIT_CONFIG}" "config.workstation"
        else
            echo -e "${__COLOR_INFO}No specific git configuration for $(hostname) available. Using the default one.${__COLOR_RESET}"
            ln -s -f "config.default" "config.workstation"
        fi
    )
}


install_docker()
{
    if command -v docker > /dev/null
    then
        sudo usermod -a -G docker "${USER}"
        sudo chmod 660 "/var/run/docker.sock"
    fi

    # Install docker-credential-pass
    DOCKER_CRED_PASS_VER="0.8.1"
    DOCKER_CRED_PASS_BIN="docker-credential-pass-v${DOCKER_CRED_PASS_VER}.linux-amd64"
    DOCKER_CRED_PASS_URL="https://github.com/docker/docker-credential-helpers/releases/download/v${DOCKER_CRED_PASS_VER}/${DOCKER_CRED_PASS_BIN}"
    (
        cd "/tmp"
        wget "${DOCKER_CRED_PASS_URL}"
        chmod 755 "${DOCKER_CRED_PASS_BIN}"
        mv -f "${DOCKER_CRED_PASS_BIN}" "${HOME}/.local/bin/docker-credential-pass"
    )

    #------------------------------------------------------------------------------#
    # Hack: setup workstation specific config for docker using extra symlink
    (
        cd "${DOTFILES}/.docker"
        TARGET_DOCKER_CONFIG="config-$(hostname).json"
        if [ -f "${TARGET_DOCKER_CONFIG}" ]; then
            ln -s -f "${TARGET_DOCKER_CONFIG}" "config.json"
        else
            echo -e "${__COLOR_INFO}No specific docker configuration for $(hostname) available. I'll leave it empty.${__COLOR_RESET}"
        fi
    )
}

install_qtile()
{
    echo -e "${__COLOR_INFO}INFO: Install Qtile desktop manager${__COLOR_RESET}"
    QTILE_PYTHON_HOME="${HOME}/.cache/qtile/python"
    QTILE_PYTHON_FILEPATH="${QTILE_PYTHON_HOME}/bin/python3"

    # Install the right Python version for qtile (>=3.10)
    if [ ! -f "${QTILE_PYTHON_FILEPATH}" ]; then
        (
            # Install Python
            TMP_PYTHON_SRC=$(mktemp -d)
            cd "${TMP_PYTHON_SRC}" || exit 1
            QTILE_PYTHON_VERSION="3.10.12"
            wget "http://www.python.org/ftp/python/${QTILE_PYTHON_VERSION}/Python-${QTILE_PYTHON_VERSION}.tgz"
            tar -zxvf "Python-${QTILE_PYTHON_VERSION}.tgz"
            cd "Python-${QTILE_PYTHON_VERSION}" || exit 1

            mkdir -p "${QTILE_PYTHON_HOME}"
            ./configure --prefix="${QTILE_PYTHON_HOME}"
            make -j"$(nproc)"
            make install
        )
    fi

    # install qtile and its dependencies for this exact version
    ${QTILE_PYTHON_FILEPATH} -m pip install --upgrade pip wheel setuptools
    ${QTILE_PYTHON_FILEPATH} -m pip install --upgrade xcffib
    ${QTILE_PYTHON_FILEPATH} -m pip install --upgrade --no-cache-dir cairocffi
    sudo apt-get install -y libpangocairo-1.0-0
    ${QTILE_PYTHON_FILEPATH} -m pip install --upgrade git+https://github.com/qtile/qtile.git
    # Install dependencies for widgets
    ${QTILE_PYTHON_FILEPATH} -m pip install --upgrade psutil

    if ( __is_linux )
    then
        echo -e "${__COLOR_INFO}INFO: Install X configs for Qtile${__COLOR_RESET}"

        # Create xsessions entry for qtile according to
        # https://docs.qtile.org/en/latest/manual/install/index.html#starting-qtile
        XSESSIONS_PATH="/usr/share/xsessions"
        if [ -d "${XSESSIONS_PATH}" ]; then
            QTILE_DESKTOP_FILE_PATH="${XSESSIONS_PATH}/qtile.desktop"
            if [ ! -f "${QTILE_DESKTOP_FILE_PATH}" ]; then
  	        echo "[Desktop Entry]
Name=Qtile
Comment=Qtile Session
Exec=startqtile
Type=Application
Keywords=wm;tiling" | sudo tee "${QTILE_DESKTOP_FILE_PATH}"
            else
  	        echo -e "${__COLOR_WARN}The file '${QTILE_DESKTOP_FILE_PATH}' already exists. Skip creation. ${__COLOR_RESET}"
            fi

            CUSTOM_DESKTOP_FILE_PATH="${XSESSIONS_PATH}/custom.desktop"
            if [ ! -f "${CUSTOM_DESKTOP_FILE_PATH}" ]; then
  	        echo "[Desktop Entry]
Name=Qtile
Comment=Qtile Session
Exec=/etc/X11/Xsession
Type=Application
Keywords=wm;tiling" | sudo tee "${CUSTOM_DESKTOP_FILE_PATH}"
            else
  	        echo -e "${__COLOR_WARN}The file '${CUSTOM_DESKTOP_FILE_PATH}' already exists. Skip creation. ${__COLOR_RESET}"
            fi
        fi

        # Install rofi
        sudo apt-get install -y \
             rofi

        ROFI_POWER_MENU="${HOME}/.local/bin/rofi-power-menu"
        if [ ! -f "${ROFI_POWER_MENU}" ]
        then
            (
                # Install Rofi power menu
                TMP_SRC=$(mktemp -d)
                cd "${TMP_SRC}" || exit 1
                git clone https://github.com/jluttine/rofi-power-menu.git
                cd rofi-power-menu || exit 1
                cp rofi-power-menu "${ROFI_POWER_MENU}"
            )
        fi
    fi
}

install_nyxt()
{
    (
        sudo apt install -y \
             sbcl

        # Download latest sbcl
        TMP_SBCL_SRC=$(mktemp -d)
        cd "${TMP_SBCL_SRC}" || exit 1
        SBCL_VERSION="2.4.4"
        SBCL_SRC_FILE_NAME="sbcl-${SBCL_VERSION}-source.tar.bz2"
        wget "http://prdownloads.sourceforge.net/sbcl/${SBCL_SRC_FILE_NAME}"
        tar -xf "${SBCL_SRC_FILE_NAME}"
        cd "sbcl-${SBCL_VERSION}" || exit 1

        # Actually compile and install it
        SBCL_INSTALL_DIR="${HOME}/.cache/common-lisp/sbcl-${SBCL_VERSION}.debian-linux-x64"
        sh make.sh --prefix="${SBCL_INSTALL_DIR}"
        sh install.sh

        # Use update alternatives to set the right version
        sudo update-alternatives --install "/usr/bin/sbcl" sbcl "${SBCL_INSTALL_DIR}/bin/sbcl" 100
        sudo update-alternatives --auto sbcl
    )
    (
        # install dependencies for compilation of Nyxt
        sudo apt install -y \
             libfixposix-dev \
             libgstreamer1.0-0 \
             gir1.2-gst-plugins-base-1.0 \
             gir1.2-gst-plugins-bad-1.0 \
             gstreamer1.0-plugins-bad \
             libwebkit2gtk-4.0-37

        # install Nyxt
        TMP_NYXT_SRC=$(mktemp -d)
        cd "${TMP_NYXT_SRC}" || exit 1
        NYXT_VERSION="3.11.6"
        NYXT_SRC_FILE_NAME="nyxt-${NYXT_VERSION}-source-with-submodules.tar.xz"
        wget "https://github.com/atlas-engineer/nyxt/releases/download/${NYXT_VERSION}/${NYXT_SRC_FILE_NAME}"
        tar -xf "${NYXT_SRC_FILE_NAME}"
        make all
        sudo make install
    )

    (
        # Install some extensions
        # The ~/.local/share/nyxt/extensions/ is the default path Nyxt looks
        # for extensions in. Change to wherever you set your extension path.
        NYXT_EXTENSION_PATH="${HOME}/.local/share/nyxt/extensions"
        mkdir -p "${NYXT_EXTENSION_PATH}"
        git clone https://github.com/aartaka/nx-search-engines "${NYXT_EXTENSION_PATH}/nx-search-engines"
    )
}

install_zsh()
{
    #------------------------------------------------------------------------------#
    # install oh-my-zsh if required
    export ZSH="${HOME}/.cache/oh-my-zsh"
    if [[ ! -f "${ZSH}/oh-my-zsh.sh" ]]; then
        sh -c "$(wget -O- https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
        # This script creates a .zshrc file in your home directory. We
        # won't need it, since we have a preconfigured one in this repo
        rm "${HOME}/.zshrc"
    fi

    POWERLEVEL10K_HOME=${ZSH}/custom/themes/powerlevel10k
    if [[ ! -d "${POWERLEVEL10K_HOME}" ]]; then
        git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${POWERLEVEL10K_HOME}"
    fi

    ZSH_AUTOSUGGESTION_HOME=${ZSH}/custom/plugins/zsh-autosuggestions
    if [[ ! -d "${ZSH_AUTOSUGGESTION_HOME}" ]]; then
        git clone https://github.com/zsh-users/zsh-autosuggestions "${ZSH_AUTOSUGGESTION_HOME}"
    fi

    ZSH_SYNTAX_HIGHLIGHTING=${ZSH}/custom/plugins/zsh-syntax-highlighting
    if [[ ! -d "${ZSH_SYNTAX_HIGHLIGHTING}" ]]; then
        git clone https://github.com/zsh-users/zsh-syntax-highlighting "${ZSH_SYNTAX_HIGHLIGHTING}"
    fi

    ZSH_YOU_SHOULD_USE=${ZSH}/custom/plugins/you-should-use
    if [[ ! -d "${ZSH_YOU_SHOULD_USE}" ]]; then
        git clone https://github.com/MichaelAquilina/zsh-you-should-use "${ZSH_YOU_SHOULD_USE}"
    fi
}

create_symlinks()
{
    # Setup all symlinks with GNU stow
    if ! command -v stow &> /dev/null
    then
        echo "Install GNU stow."
        sudo apt-get update && sudo apt-get install -y stow
    fi

    echo -e "${__COLOR_INFO}INFO: Setup symbolic links with GNU stow.${__COLOR_RESET}"
    (
        cd "${DOTFILES}"
        stow . -t "${HOME}"
    )
    # -------------------------------------------------
    # GNUPG setup

    # To fix the " gpg: WARNING: unsafe permissions on homedir '/home/path/to/user/.gnupg' " error
    # Make sure that the .gnupg directory and its contents is accessibile by your user.
    chown -R "$(whoami)" "${HOME}/.gnupg/"

    # Also correct the permissions and access rights on the directory
    chmod 700 "${HOME}/.gnupg"
}

#------------------------------------------------------------------------------#

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_BASE}" ]; } || [ -n "${INSTALL_BASE}" ]
then
    install_base
    install_git
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_ZSH}" ]; } || [ -n "${INSTALL_ZSH}" ]
then
    install_zsh
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_NPM}" ]; } || [ -n "${INSTALL_NPM}" ]
then
    install_npm
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_QTILE}" ]; } || [ -n "${INSTALL_QTILE}" ]
then
    install_qtile
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_DOCKER}" ]; } || [ -n "${INSTALL_DOCKER}" ]
then
    install_docker
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_NYXT}" ]; } || [ -n "${INSTALL_NYXT}" ]
then
    install_nyxt
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_EMACS}" ]; } || [ -n "${INSTALL_EMACS}" ]
then
    install_emacs
fi

if [ -z "${SKIP_STOW}" ]
then
    create_symlinks
fi
