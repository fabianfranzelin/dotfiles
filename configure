#!/usr/bin/env bash

# shellcheck disable=SC1090,SC1091

#------------------------------------------------------------------------------#
# description of cmdline-parser
# @formatter:off
usage="
USAGE
    ${0} [OPTION]...

DESCRIPTION
       Configures and installs the system.

       -h --help
              Print this help message
       -i --install-all
              Install all third-party dependencies
       --skip-stow
              Skip stowing links
       --install-base
              Install base packages
       --skip-base
              Skip base installation
       --install-git
              Install git packages
       --update-git-credentials
              Update git credentials
       --skip-git
              Skip git installation
       --install-npm
              Install npm packages
       --skip-npm
              Skip npm installation
       --install-zsh
              Install ZSH
       --skip-zsh
              Skip ZSH installation
       --install-emacs
              Install Emacs
       --skip-emacs
              Skip Emacs installation
       --install-docker
              Install Docker
       --skip-docker
              Skip Docker installation
       --install-qtile
              Install Qtile
       --skip-qtile
              Skip Qtile installation
       --upgrade-packages
              Check for newer versions of third-party packages and
              update versions.conf (does not install anything)
       --overlay-dir <path>
              Additional dotfiles directory to stow and configure
              (can be specified multiple times)
"
# @formatter:on

#------------------------------------------------------------------------------#
# check prerequisites

# exit as soon as error occurs
set -e

export DOTFILES
if command -v git > /dev/null
then
    DOTFILES=$(git rev-parse --show-toplevel)
else
    SCRIPT_NAME=$(readlink -f "${BASH_SOURCE[0]}")
    DOTFILES=$(realpath "$(dirname "${SCRIPT_NAME}")")
fi

export __SHELL_LIB
__SHELL_LIB="${DOTFILES}/.config/shell"
. "${__SHELL_LIB}/formatting.sh"
. "${__SHELL_LIB}/faq.sh"

# load gear
. "${__SHELL_LIB}/func/install_helpers"
. "${__SHELL_LIB}/func/install_base"
. "${__SHELL_LIB}/func/install_git"
. "${__SHELL_LIB}/func/install_npm"
. "${__SHELL_LIB}/func/install_docker"
. "${__SHELL_LIB}/func/install_emacs"
. "${__SHELL_LIB}/func/install_qtile"
. "${__SHELL_LIB}/func/install_zsh"
. "${__SHELL_LIB}/func/upgrade_packages"

#------------------------------------------------------------------------------#
# make sure that default environment variables are set correctly

export LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}

#------------------------------------------------------------------------------#
# cmdline-parser

OVERLAY_DIRS=()

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        '-h'|'--help')
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 0
            ;;
        '-i'|'--install-all')
            INSTALL_ALL=1
            shift # past argument
            ;;
        '--skip-stow')
            SKIP_STOW=1
            shift # past argument
            ;;
        '--install-base')
            INSTALL_BASE=1
            shift # past argument
            ;;
        '--skip-base')
            SKIP_BASE=1
            shift # past argument
            ;;
        '--install-git')
            INSTALL_GIT=1
            shift # past argument
            ;;
        '--update-git-credentials')
            UPDATE_GIT_CREDENTIALS=1
            shift # past argument
            ;;
        '--skip-git')
            SKIP_GIT=1
            shift # past argument
            ;;
        '--install-npm')
            INSTALL_NPM=1
            shift # past argument
            ;;
        '--skip-npm')
            SKIP_NPM=1
            shift # past argument
            ;;
        '--install-emacs')
            INSTALL_EMACS=1
            shift # past argument
            ;;
        '--skip-emacs')
            SKIP_EMACS=1
            shift # past argument
            ;;
        '--install-docker')
            INSTALL_DOCKER=1
            shift # past argument
            ;;
        '--skip-docker')
            SKIP_DOCKER=1
            shift # past argument
            ;;
        '--install-qtile')
            INSTALL_QTILE=1
            shift # past argument
            ;;
        '--skip-qtile')
            SKIP_QTILE=1
            shift # past argument
            ;;
        '--install-zsh')
            INSTALL_ZSH=1
            shift # past argument
            ;;
        '--skip-zsh')
            SKIP_ZSH=1
            shift # past argument
            ;;
        '--upgrade-packages')
            UPGRADE_PACKAGES=1
            shift # past argument
            ;;
        '--overlay-dir')
            OVERLAY_DIRS+=("$(realpath "$2")")
            shift 2
            ;;
        *)
            echo -e "${__COLOR_ERR}Unknown value ${1}${__COLOR_RESET}"
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 1
            ;;
    esac
done

create_symlinks()
{
    # Setup all symlinks with GNU stow
    if ! command -v stow &> /dev/null
    then
        echo "Install GNU stow."
        sudo apt-get update && sudo apt-get install -y stow
    fi

    # Remove default/overlay-provided symlinks that would conflict with stow.
    # These targets are not owned by base stow (they are created via ln -sf
    # after stowing, or provided by an overlay). Remove them unconditionally
    # so a previous overlay install does not block a subsequent non-overlay
    # run (and vice versa). They will be recreated below.
    for target in "${HOME}/.config/npm/npmrc" "${HOME}/.docker/config.json" "${HOME}/.gnupg/gpg.conf"; do
        if [ -L "${target}" ]; then
            rm -f "${target}"
        fi
    done

    echo -e "${__COLOR_INFO}INFO: Setup symbolic links with GNU stow.${__COLOR_RESET}"
    (
        cd "${DOTFILES}"
        if [ ${#OVERLAY_DIRS[@]} -gt 0 ]; then
            stow -R . -t "${HOME}" --no-folding
        else
            stow -R . -t "${HOME}"
        fi
    )

    for overlay in "${OVERLAY_DIRS[@]}"; do
        if [ -d "${overlay}" ]; then
            echo -e "${__COLOR_INFO}INFO: Stowing overlay: ${overlay}${__COLOR_RESET}"
            # Remove base-stow symlinks that the overlay will replace
            for target in "${HOME}/.config/npm/npmrc" "${HOME}/.docker/config.json" "${HOME}/.gnupg/gpg.conf"; do
                if [ -L "${target}" ]; then
                    rm -f "${target}"
                fi
            done
            (cd "${overlay}" && stow -R . -t "${HOME}")
        else
            echo -e "${__COLOR_ERR}Overlay directory not found: ${overlay}${__COLOR_RESET}"
        fi
    done

    # -------------------------------------------------
    # Create default symlinks for files that overlays may provide.
    # Only create if the target does not already exist (overlay takes precedence).

    if [ ! -e "${HOME}/.config/npm/npmrc" ]; then
        ln -sf "npmrc.default" "${HOME}/.config/npm/npmrc"
    fi

    if [ ! -e "${HOME}/.docker/config.json" ]; then
        ln -sf "config-default.json" "${HOME}/.docker/config.json"
    fi

    if [ ! -e "${HOME}/.gnupg/gpg.conf" ]; then
        ln -sf "gpg.conf.default" "${HOME}/.gnupg/gpg.conf"
    fi

    # -------------------------------------------------
    # GNUPG setup

    # To fix the " gpg: WARNING: unsafe permissions on homedir '/home/path/to/user/.gnupg' " error
    # Make sure that the .gnupg directory and its contents is accessibile by your user.
    chown -R "$(whoami)" "${HOME}/.gnupg/"

    # Also correct the permissions and access rights on the directory
    chmod 700 "${HOME}/.gnupg"
}

#------------------------------------------------------------------------------#

if [ -n "${UPGRADE_PACKAGES:-}" ]
then
    upgrade_packages
    exit $?
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_BASE}" ]; } || [ -n "${INSTALL_BASE}" ]
then
    install_base
    install_git
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_GIT}" ]; } || [ -n "${INSTALL_GIT}" ]
then
    install_git
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_GIT}" ]; } || [ -n "${INSTALL_GIT}" ] || [ -n "${UPDATE_GIT_CREDENTIALS}" ]
then
    generate_git_credentials
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_ZSH}" ]; } || [ -n "${INSTALL_ZSH}" ]
then
    install_zsh
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_NPM}" ]; } || [ -n "${INSTALL_NPM}" ]
then
    install_npm
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_QTILE}" ]; } || [ -n "${INSTALL_QTILE}" ]
then
    install_qtile
    install_betterlockscreen
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_DOCKER}" ]; } || [ -n "${INSTALL_DOCKER}" ]
then
    install_docker
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_EMACS}" ]; } || [ -n "${INSTALL_EMACS}" ]
then
    install_emacs
fi

if [ -z "${SKIP_STOW}" ]
then
    create_symlinks
fi

# Always generate personal git credentials
generate_git_credentials

# Run overlay configure scripts
for overlay in "${OVERLAY_DIRS[@]}"; do
    if [ -x "${overlay}/configure" ]; then
        echo -e "${__COLOR_INFO}INFO: Running overlay configure: ${overlay}/configure${__COLOR_RESET}"
        "${overlay}/configure"
    fi
done

# -------------------------------------------------
# Hostname-based git config symlinks
# Runs after overlays so that generated files (e.g. credentials) are available.
if [ -z "${SKIP_STOW}" ]; then
    _hostname=$(hostname)
    git_config_dir="${HOME}/.config/git"
    for suffix in "" ".infra"; do
        target="config.${_hostname}${suffix}"
        link="${git_config_dir}/config.host${suffix}"
        if [ -e "${git_config_dir}/${target}" ]; then
            ln -sf "${target}" "${link}"
        else
            rm -f "${link}"
        fi
    done
fi
