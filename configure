#!/usr/bin/env bash

# shellcheck disable=SC1090,SC1091

#------------------------------------------------------------------------------#
# description of cmdline-parser
usage="
USAGE
    ${0} [OPTION]...

DESCRIPTION
       Configures and installs the system.

       -h --help
              Print this help message
       -i --install
              Install third-party dependencies
       --skip-emacs-build
              Skip building Emacs from source
"

#------------------------------------------------------------------------------#
# check prerequisites

# exit as soon as error occurs
set -e

export DOTFILES
DOTFILES=$(git rev-parse --show-toplevel)
export __SHELL_LIB
__SHELL_LIB="${DOTFILES}/.config/shell"

. "${__SHELL_LIB}/formatting.sh"
. "${__SHELL_LIB}/faq.sh"

#------------------------------------------------------------------------------#
# cmdline-parser

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        '-h'|'--help')
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 0
            ;;
        '-i'|'--install')
            INSTALL_DEPENDENCIES=1
            shift # past argument
            ;;
        '--load-submodules')
            LOAD_SUBMODULES=1
            shift # past argument
            ;;
        '--skip-emacs-build')
            SKIP_EMACS_BUILD=1
            shift # past argument
            ;;
        *)
            echo -e "${__COLOR_ERR}Unknown value ${1}${__COLOR_RESET}"
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 1
            ;;
    esac
done

#------------------------------------------------------------------------------#
# install required packages
if [ -n "${LOAD_SUBMODULES}" ]; then
    echo -e "${__COLOR_INFO}INFO: Load submodules${__COLOR_RESET}"
    git submodule init
    git submodule update --recursive
fi

#------------------------------------------------------------------------------#
# setup symbolic links first
#------------------------------------------------------------------------------#
# Setup all symlinks with GNU stow
if ! command -v stow &> /dev/null
then
    echo "Install GNU stow."
    sudo apt update && sudo apt install -y stow
fi

echo -e "${__COLOR_INFO}INFO: Setup symbolic links with GNU stow.${__COLOR_RESET}"
(
    cd "${DOTFILES}"
    stow . -t "${HOME}"
)

#------------------------------------------------------------------------------#
# install required packages
if [ -n "${INSTALL_DEPENDENCIES}" ]; then
    echo -e "${__COLOR_INFO}INFO: Installing minimal required packages for setup...${__COLOR_RESET}"
    sudo apt-get install -y \
         python3-pip

    # Remove PyQt5 if installed via pip. This package is buggy. It is
    # installed afterwards again via Ubuntu package sources.
    # python3 -m pip uninstall PyQt5

    # Make sure that there is just one venv package installed. We do
    # this via pip
    sudo apt remove -y python3-venv

    # Update python setuptools to latest release from pypi
    python3 -m pip install --upgrade \
            setuptools \
            pip \
            wheel

    sudo apt install -y \
         xclip \
         apt-transport-https \
         python3-pyqt5 \
         zsh \
         direnv \
         gnome-keyring \
         openjdk-17-jdk \
         zip \
         wget \
         unzip \
         stow \
         compton \
         nitrogen \
         dmenu \
         rofi \
         vim \
         git-lfs \
         ccache \
         gnuplot \
         pass \
         gnupg \
         terminator

    # ---------------------------------------------------------
    # install Emacs. First, just the regular version.
    if ! command -v emacs &> /dev/null
    then
        echo "Install default Emacs from package sources."
        sudo apt install -y \
             emacs
    fi

    if [ -z "${SKIP_EMACS_BUILD}" ]; then
        (
            # now, install the newest version available by building and
            # installing it manually
            cd "${DOTFILES}/.config/emacs" || exit 1
            # This creates the install script for Emacs
            emacs -Q --batch \
                  --eval "(require 'org)" \
                  --eval '(org-babel-tangle-file "README.org")'
            # Actually install Emacs via update-alternatives
            ./install.sh -v 29 || exit 1
        )
    fi
    # install dependencies for Emacs
    sudo apt install -y \
         markdown \
         pandoc \
         graphviz \
         fonts-cantarell \
         cmake \
         libtool-bin \
         aspell aspell-de aspell-en \
         clang-format \
         clang-tidy \
         clangd-12 \
         clang \
         valgrind \
         ripgrep \
         fd-find \
         shellcheck

    # emacs pdf-tools dependencies
    sudo apt install -y \
         libpng-dev \
	 zlib1g-dev \
         libpoppler-glib-dev \
         libpoppler-private-dev \
         imagemagick

    # additional python dependencies
    python3 -m pip install --upgrade \
            virtualenv \
            epc \
            ptvsd \
            black \
            isort \
            yamllint \
            mdformat \
            cmake_language_server \
            "python-lsp-server[all]" \
            pylsp-mypy \
            python-lsp-black \
            esbonio \
            robotframework-tidy \
            ipython

    # additional npm dependencies
    if ( __is_linux ) then
       if [ ! -d "${HOME}/.config/nvm" ]
       then
           # use nvm to install node, npm, etc. See
           # https://github.com/nvm-sh/nvm for details.
           wget -qO- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.3/install.sh | bash
       fi
       # load nvm paths
       export NVM_DIR="${HOME}/.config/nvm"
       [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"  # This loads nvm
       export NVM_DIR="${HOME}/.nvm"
       [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"  # This loads nvm

       # install npm v16 as default
       nvm install 14
       nvm use 14

       # install lsp servers, linters, etc.
       npm install -g \
           yaml-language-server \
           bash-language-server \
           typescript \
           typescript-language-server \
           dockerfile-language-server-nodejs \
           jsonlint

       # install other npm packages
       npm install -g \
           yarn
    fi

    # -------------------------------------------------
    # Docker setup
    if command -v docker > /dev/null
    then
        sudo usermod -a -G docker "${USER}"
        sudo chmod 660 "/var/run/docker.sock"
    fi

    #------------------------------------------------------------------------------#
    # install dependencies for vscode
    if ( __is_linux ) then
       # note that vscode is mounted from Windows in WSL and not
       # installed via apt. Ignore when code cannot be found
       sudo apt install code || true
    fi

    # Install extensions if code is actually present in the path,
    # otherwise skip it
    if command -v code > /dev/null
    then
        for CODE_EXTENSION_ID in $(sed -e 's/#.*//' "${DOTFILES}/.config/Code/User/extensions.txt"); do
            code --force --install-extension "${CODE_EXTENSION_ID}"
        done
    fi

    if ( __is_linux ) then
       # Install tools that solely work on Ubuntu desktop. Note
       # that this is not working for Docker or WSL.
       echo -e "${__COLOR_INFO}INFO: Install GTK tools${__COLOR_RESET}"

       # Install Qtile window manager
       python3 -m pip install --upgrade --use-pep517 xcffib
       python3 -m pip install --upgrade --no-cache-dir cairocffi
       sudo apt install -y libpangocairo-1.0-0
       python3 -m pip install --upgrade qtile

       # Create xsessions entry for qtile according to
       # https://docs.qtile.org/en/latest/manual/install/index.html#starting-qtile
       XSESSIONS_PATH="/usr/share/xsessions"
       if [ -d "${XSESSIONS_PATH}" ]; then
           QTILE_DESKTOP_FILE_PATH="${XSESSIONS_PATH}/qtile.desktop"
           if [ ! -f "${QTILE_DESKTOP_FILE_PATH}" ]; then
               echo "[Desktop Entry]
Name=Qtile
Comment=Qtile Session
Exec=qtile start
Type=Application
Keywords=wm;tiling" | sudo tee "${QTILE_DESKTOP_FILE_PATH}"
           else
               echo -e "${__COLOR_WARN}The file '${QTILE_DESKTOP_FILE_PATH}' already exists. Skip creation. ${__COLOR_RESET}"
           fi

           CUSTOM_DESKTOP_FILE_PATH="${XSESSIONS_PATH}/custom.desktop"
           if [ ! -f "${CUSTOM_DESKTOP_FILE_PATH}" ]; then
               echo "[Desktop Entry]
Name=Qtile
Comment=Qtile Session
Exec=/etc/X11/Xsession
Type=Application
Keywords=wm;tiling" | sudo tee "${CUSTOM_DESKTOP_FILE_PATH}"
           else
               echo -e "${__COLOR_WARN}The file '${CUSTOM_DESKTOP_FILE_PATH}' already exists. Skip creation. ${__COLOR_RESET}"
           fi
       else
           echo -e "${__COLOR_INFO}INFO: skipping xsession configuration for qtile"
       fi
       sudo apt install -y \
            vlc \
            firefox \
            eog
    else
       echo -e "${__COLOR_INFO}INFO: Skip installing GTK tools since we are running in WSL or Docker.${__COLOR_RESET}"
    fi

    #------------------------------------------------------------------------------#
    # install oh-my-zsh if required
    export ZSH="${HOME}/.cache/oh-my-zsh"
    if [[ ! -f "${ZSH}/oh-my-zsh.sh" ]]; then
        sh -c "$(wget -O- https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
        # This script creates a .zshrc file in your home directory. We
        # won't need it, since we have a preconfigured one in this repo
        rm "${HOME}/.zshrc"
    fi

    POWERLEVEL10K_HOME=${ZSH}/custom/themes/powerlevel10k
    if [[ ! -d "${POWERLEVEL10K_HOME}" ]]; then
        git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${POWERLEVEL10K_HOME}"
    fi

    ZSH_AUTOSUGGESTION_HOME=${ZSH}/custom/plugins/zsh-autosuggestions
    if [[ ! -d "${ZSH_AUTOSUGGESTION_HOME}" ]]; then
        git clone https://github.com/zsh-users/zsh-autosuggestions "${ZSH_AUTOSUGGESTION_HOME}"
    fi

    ZSH_SYNTAX_HIGHLIGHTING=${ZSH}/custom/plugins/zsh-syntax-highlighting
    if [[ ! -d "${ZSH_SYNTAX_HIGHLIGHTING}" ]]; then
        git clone https://github.com/zsh-users/zsh-syntax-highlighting "${ZSH_SYNTAX_HIGHLIGHTING}"
    fi

    ZSH_YOU_SHOULD_USE=${ZSH}/custom/plugins/you-should-use
    if [[ ! -d "${ZSH_YOU_SHOULD_USE}" ]]; then
        git clone https://github.com/MichaelAquilina/zsh-you-should-use "${ZSH_YOU_SHOULD_USE}"
    fi
fi

#------------------------------------------------------------------------------#
# Hack: setup workstation specific config for git using extra symlink
(
    cd "${DOTFILES}/.config/git"
    TARGET_GIT_CONFIG="config.$(hostname)"
    if [ -f "${TARGET_GIT_CONFIG}" ]; then
        ln -s -f "${TARGET_GIT_CONFIG}" "config.workstation"
    else
        echo -e "${__COLOR_INFO}No specific git configuration for $(hostname) available. Using the default one.${__COLOR_RESET}"
        ln -s -f "config.default" "config.workstation"
    fi
)

#------------------------------------------------------------------------------#
# Hack: setup workstation specific config for npm using extra symlink
(
    cd "${DOTFILES}/.config/npm"
    TARGET_NPM_CONFIG="npmrc.$(hostname)"
    if [ -f "${TARGET_NPM_CONFIG}" ]; then
        ln -s -f "${TARGET_NPM_CONFIG}" "npmrc"
    else
        echo -e "${__COLOR_INFO}No specific npm configuration for $(hostname) available. Using the default one.${__COLOR_RESET}"
        ln -s -f "npmrc.default" "npmrc"
    fi
)
