#!/usr/bin/env bash

# shellcheck disable=SC1090,SC1091

#------------------------------------------------------------------------------#
# description of cmdline-parser
usage="
USAGE
    ${0} [OPTION]...

DESCRIPTION
       Configures and installs the system.

       -h --help
              Print this help message
       -i --install-all
              Install all third-party dependencies
       --skip-stow
              Skip stowing links
       --install-base
              Install base packages
       --skip-base
              Skip base installation
       --install-npm
              Install npm packages
       --skip-npm
              Skip npm installation
       --install-zsh
              Install ZSH
       --skip-zsh
              Skip ZSH installation
       --install-emacs
              Install Emacs
       --skip-emacs
              Skip Emacs installation
       --install-docker
              Install Docker
       --skip-docker
              Skip Docker installation
       --install-qtile
              Install Qtile
       --skip-qtile
              Skip Qtile installation
       --install-nyxt
              Install nyxt
       --skip-nyxt
              Skip nyxt installation
"

#------------------------------------------------------------------------------#
# check prerequisites

# exit as soon as error occurs
set -e

export DOTFILES
if command -v git > /dev/null
then
    DOTFILES=$(git rev-parse --show-toplevel)
else
    SCRIPT_NAME=$(readlink -f "${BASH_SOURCE[0]}")
    DOTFILES=$(realpath "$(dirname "${SCRIPT_NAME}")")
fi

export __SHELL_LIB
__SHELL_LIB="${DOTFILES}/.config/shell"
. "${__SHELL_LIB}/formatting.sh"
. "${__SHELL_LIB}/faq.sh"

# load gear
. "${__SHELL_LIB}/func/install_base"
. "${__SHELL_LIB}/func/install_git"
. "${__SHELL_LIB}/func/install_python_3_10"
. "${__SHELL_LIB}/func/install_npm"
. "${__SHELL_LIB}/func/install_docker"
. "${__SHELL_LIB}/func/install_emacs"
. "${__SHELL_LIB}/func/install_nyxt"
. "${__SHELL_LIB}/func/install_qtile"
. "${__SHELL_LIB}/func/install_zsh"

#------------------------------------------------------------------------------#
# make sure that default environment variables are set correctly

export LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}

#------------------------------------------------------------------------------#
# cmdline-parser

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        '-h'|'--help')
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 0
            ;;
        '-i'|'--install-all')
            INSTALL_ALL=1
            shift # past argument
            ;;
        '--skip-stow')
            SKIP_STOW=1
            shift # past argument
            ;;
        '--install-base')
            INSTALL_BASE=1
            shift # past argument
            ;;
        '--skip-base')
            SKIP_BASE=1
            shift # past argument
            ;;
        '--install-npm')
            INSTALL_NPM=1
            shift # past argument
            ;;
        '--skip-npm')
            SKIP_NPM=1
            shift # past argument
            ;;
        '--install-emacs')
            INSTALL_EMACS=1
            shift # past argument
            ;;
        '--skip-emacs')
            SKIP_EMACS=1
            shift # past argument
            ;;
        '--install-docker')
            INSTALL_DOCKER=1
            shift # past argument
            ;;
        '--skip-docker')
            SKIP_DOCKER=1
            shift # past argument
            ;;
        '--install-qtile')
            INSTALL_QTILE=1
            shift # past argument
            ;;
        '--skip-qtile')
            SKIP_QTILE=1
            shift # past argument
            ;;
        '--install-nyxt')
            INSTALL_NYXT=1
            shift # past argument
            ;;
        '--skip-nyxt')
            SKIP_NYXT=1
            shift # past argument
            ;;
        '--install-zsh')
            INSTALL_ZSH=1
            shift # past argument
            ;;
        '--skip-zsh')
            SKIP_ZSH=1
            shift # past argument
            ;;
        *)
            echo -e "${__COLOR_ERR}Unknown value ${1}${__COLOR_RESET}"
            echo -e "${__COLOR_INFO}${usage}${__COLOR_RESET}"
            exit 1
            ;;
    esac
done

create_symlinks()
{
    # Setup all symlinks with GNU stow
    if ! command -v stow &> /dev/null
    then
        echo "Install GNU stow."
        sudo apt-get update && sudo apt-get install -y stow
    fi

    echo -e "${__COLOR_INFO}INFO: Setup symbolic links with GNU stow.${__COLOR_RESET}"
    (
        cd "${DOTFILES}"
        stow . -t "${HOME}"
    )
    # -------------------------------------------------
    # GNUPG setup

    # To fix the " gpg: WARNING: unsafe permissions on homedir '/home/path/to/user/.gnupg' " error
    # Make sure that the .gnupg directory and its contents is accessibile by your user.
    chown -R "$(whoami)" "${HOME}/.gnupg/"

    # Also correct the permissions and access rights on the directory
    chmod 700 "${HOME}/.gnupg"
}

#------------------------------------------------------------------------------#

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_BASE}" ]; } || [ -n "${INSTALL_BASE}" ]
then
    install_base
    install_git
    install_python_3_10
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_ZSH}" ]; } || [ -n "${INSTALL_ZSH}" ]
then
    install_zsh
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_NPM}" ]; } || [ -n "${INSTALL_NPM}" ]
then
    install_npm
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_QTILE}" ]; } || [ -n "${INSTALL_QTILE}" ]
then
    install_qtile
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_DOCKER}" ]; } || [ -n "${INSTALL_DOCKER}" ]
then
    install_docker
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_NYXT}" ]; } || [ -n "${INSTALL_NYXT}" ]
then
    install_nyxt
fi

if { [ -n "${INSTALL_ALL}" ] && [ -z "${SKIP_EMACS}" ]; } || [ -n "${INSTALL_EMACS}" ]
then
    install_emacs
fi

if [ -z "${SKIP_STOW}" ]
then
    create_symlinks
fi
