# default options
display_on=1
span_image=true
lock_timeout=300
fx_list=(dim blur dimblur pixel dimpixel color)
dim_level=40
blur_level=1
pixel_scale=10,1000
solid_color=333333
wallpaper_cmd="feh --bg-fill"
quiet=false

# theme (Doom Vibrant palette)
loginbox=282c3466
loginshadow=00000000
locktext="Type password to unlock..."
font="JetBrains Mono"
ringcolor=51afefff
insidecolor=282c34ff
separatorcolor=00000000
ringvercolor=99bb66ff
insidevercolor=282c34ff
ringwrongcolor=ff6655ff
insidewrongcolor=282c34ff
timecolor=bfbfbfff
time_format="%H:%M:%S"
greetercolor=bfbfbfff
layoutcolor=bfbfbfff
keyhlcolor=c678ddff
bshlcolor=ff6655ff
veriftext="Verifying..."
verifcolor=99bb66ff
wrongtext="Failure!"
wrongcolor=ff6655ff
modifcolor=ECBE7Bff
bgcolor=282c34ff


#
# expert options (change at own risk!)
#

# i3lock-color - custom arguments
lockargs=(-n)
lockargs+=(--pass-media-keys)
lockargs+=(--pass-volume-keys)
