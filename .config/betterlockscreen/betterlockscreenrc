# default options
display_on=1
span_image=true
lock_timeout=300
fx_list=(dim blur dimblur pixel dimpixel color)
dim_level=40
blur_level=1
pixel_scale=10,1000
solid_color=333333
wallpaper_cmd="feh --bg-fill"
quiet=false

# theme (Doom Palenight palette)
loginbox=282c3466
loginshadow=00000000
locktext="Type password to unlock..."
font="JetBrains Mono"
ringcolor=82aaffff
insidecolor=282c34ff
separatorcolor=00000000
ringvercolor=c3e88dff
insidevercolor=282c34ff
ringwrongcolor=ff5370ff
insidewrongcolor=282c34ff
timecolor=EEFFFFff
time_format="%H:%M:%S"
greetercolor=EEFFFFff
layoutcolor=EEFFFFff
keyhlcolor=c792eaff
bshlcolor=ff5370ff
veriftext="Verifying..."
verifcolor=c3e88dff
wrongtext="Failure!"
wrongcolor=ff5370ff
modifcolor=ffcb6bff
bgcolor=282c34ff


#
# expert options (change at own risk!)
#

# i3lock-color - custom arguments
lockargs=(-n)
lockargs+=(--pass-media-keys)
lockargs+=(--pass-volume-keys)
