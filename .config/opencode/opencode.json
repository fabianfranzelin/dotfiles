{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-power-pack@git+https://github.com/waybarrios/opencode-power-pack.git"
  ],
  "model": "ollama/gemma4:12b",
  "provider": {
    "bosch-model-farm": {
      "name": "Bosch Model Farm",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://aoai-farm.bosch-temp.com/api/openai/deployments/askbosch-prod-farm-openai-gpt-4o-mini-2024-07-18",
        "headers": {
          "api-key": "BMF_KEY_PLACEHOLDER"
        }
      },
      "models": {
        "askbosch-prod-farm-openai-gpt-4o-mini-2024-07-18": {
          "name": "GPT-4o Mini (BMF)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    },
    "ollama": {
      "name": "Ollama Local",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "devstral:24b": {
          "name": "Devstral 24B (Agentic)",
          "contextWindow": 131072,
          "tools": false,
          "options": {
            "num_ctx": 32768
          }
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B (MoE)",
          "contextWindow": 262144,
          "tools": true,
          "options": {
            "num_ctx": 32768
          }
        },
        "gemma4:12b": {
          "name": "Gemma 4 12B",
          "contextWindow": 262144,
          "tools": true,
          "options": {
            "num_ctx": 32768
          }
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B",
          "contextWindow": 131072,
          "tools": true,
          "options": {
            "num_ctx": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "docupedia-docker-mcp-server": {
      "type": "local",
      "command": [
        "run-docupedia-mcp"
      ],
      "enabled": true,
      "env": {
        "TRANSPORT": "stdio",
        "HOST": "localhost",
        "HOST_PORT": "8000",
        "HTTP_PROXY": "http://rb-proxy-de.bosch.com:8080",
        "HTTPS_PROXY": "http://rb-proxy-de.bosch.com:8080",
        "http_proxy": "http://rb-proxy-de.bosch.com:8080",
        "https_proxy": "http://rb-proxy-de.bosch.com:8080"
      }
    }
  }
}
