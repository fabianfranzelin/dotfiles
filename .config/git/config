[include]
    path = "~/.config/git/config.workstation"
[core]
    trustctime = false
    autocrlf = false
    safecrlf = true
    eol = lf
[gc]
    autoDetach = false
[push]
    default = simple
    recurseSubmodules = check
[pull]
    rebase = true
[fetch]
    prune = true
[lfs]
    storage = "~/.cache/git/lfs"
[include]
    path = "~/.config/git/config.alias"