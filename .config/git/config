[include]
    path = "~/.config/git/config.default"
[include]
    path = "~/.config/git/config.host"
[include]
    path = "~/.config/git/config.host.infra"
[core]
    trustctime = false
    autocrlf = false
    safecrlf = true
    eol = lf
[gc]
    autoDetach = false
[push]
    default = simple
    recurseSubmodules = check
[pull]
    rebase = true
[fetch]
    prune = true
[lfs]
    storage = "~/.cache/git/lfs"
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
[include]
    path = "~/.config/git/config.alias"