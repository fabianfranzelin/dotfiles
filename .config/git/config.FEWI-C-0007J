[http "https://*.bosch.com/"]
    proxy =
[http "http://*.*.bosch.com/"]
    proxy =
[http "https://*.*.bosch.com/"]
    proxy =
[http "http://*.*.*.bosch.com/"]
    proxy =
[http "https://*.*.*.bosch.com/"]
    proxy =
