[global_config]
  dbus = False
  extra_styling = False
[keybindings]
[profiles]
  [[default]]
    urgent_bell = True
    icon_bell = False
    background_color = "#1c1f24"
    background_darkness = 0.9
    background_type = transparent
    font = JetBrains Mono NL 13
    scrollback_infinite = True
    login_shell = True
    use_custom_command = True
    custom_command = /bin/zsh
    use_system_font = False
    title_transmit_bg_color = "#1c1f24"
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      type = Terminal
    [[[window0]]]
      parent = ""
      type = Window
[plugins]
