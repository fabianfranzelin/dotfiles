[global_config]
  dbus = False
  geometry_hinting = True
  extra_styling = False
  always_on_top = True
  title_transmit_bg_color = "#a9a1e1"
  suppress_multiple_term_dialog = True
  title_font = Noto Sans 9
[keybindings]
[profiles]
  [[default]]
    urgent_bell = True
    icon_bell = False
    background_color = "#1c1f24"
    background_darkness = 0.9
    background_type = transparent
    cursor_color = "#aaaaaa"
    font = Ubuntu Mono Regular 13
    scrollback_infinite = True
    login_shell = True
    use_custom_command = True
    custom_command = /bin/zsh
    use_system_font = False
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      type = Terminal
    [[[window0]]]
      parent = ""
      type = Window
[plugins]
