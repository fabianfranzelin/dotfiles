[global_config]
  dbus = False
  always_on_top = True
[keybindings]
[profiles]
  [[default]]
    background_darkness = 0.9
    background_type = transparent
    cursor_color = "#aaaaaa"
    scrollback_infinite = True
    login_shell = True
    use_custom_command = True
    custom_command = /bin/zsh
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      type = Terminal
    [[[window0]]]
      parent = ""
      type = Window
[plugins]
