# allow local gdb configurations (restricted to workspace)
set auto-load safe-path ~/workspace

set confirm off
set verbose off
set pagination off
set prompt \033[35mgdb$ \033[0m

# Display instructions in Intel format
set disassembly-flavor intel

# Pretty printing
set print pretty on
set print array on
set print object on
set print static-members off
set print vtbl on

# for realgud tracking
set annotate 1

# save history over multiple sessions
set history filename ~/.cache/gdb_history
set history save on
set history size 10000
set history remove-duplicates unlimited

# for asynchronous debugging of multiple processes
# set target-async on

# Python pretty-printers for STL containers (if available)
python
import sys
import os
gcc_printer_path = '/usr/share/gcc/python'
if os.path.exists(gcc_printer_path):
    sys.path.insert(0, gcc_printer_path)
    from libstdcxx.v6.printers import register_libstdcxx_printers
    register_libstdcxx_printers(None)
end
