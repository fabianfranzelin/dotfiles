# allow local gdb configurations
set auto-load safe-path /

set confirm off
set verbose off
set prompt \033[31mgdb$ \033[0m

# Display instructions in Intel format
set disassembly intel

# These make gdb never pause in its output
set height 0
set width 0

set $SHOW_CONTEXT = 1
set $SHOW_NEST_INSN = 0

# add glibc source path
dir ~/.local/share/glibc-2.39/sysdeps/unix/sysv/linux/
