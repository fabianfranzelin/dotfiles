# allow local gdb configurations
set auto-load safe-path /

set confirm off
set verbose off
set prompt \033[31mgdb$ \033[0m

# Display instructions in Intel format
# set disassembly intel

# These make gdb never pause in its output
set height 0
set width 0

set $SHOW_CONTEXT = 1
set $SHOW_NEST_INSN = 0

# add glibc source path
# dir ~/.local/share/glibc-2.40/sysdeps/unix/sysv/linux/

# for realgud tracking
set annotate 1

# save history over multiple sessions
set history filename ~/.cache/gdb_history
set history save on
set history size 512

# for asynchronuous debugging of multiple processes. It allows you to execute commands as the process runs in the background.
# set target-async on
