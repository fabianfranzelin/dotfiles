#!/usr/bin/env sh

aos_create_venv() {
    (
        AOS_BASE_DIR=$(git rev-parse --show-toplevel)
        AOS_REPO_NAME=$(basename "${AOS_BASE_DIR}")
        cd "${AOS_BASE_DIR}" || exit 1
        VIRTUALENV_NAME="${AOS_REPO_NAME}"
        VIRTUALENV_PATH="${HOME}/.virtualenvs/${VIRTUALENV_NAME}"
        VIRTUALENV_ACTIVATE_FILEPATH="${HOME}/.virtualenvs/${VIRTUALENV_NAME}/bin/activate"
        PYTHON_HOME="${HOME}/.cache/python_3_10"
        PYTHON_FILEPATH="${PYTHON_HOME}/bin/python3"
        
        echo "Create virtualenv ${VIRTUALENV_NAME}"
        rm -rf "${VIRTUALENV_PATH}"
        ${PYTHON_FILEPATH} -m venv "${VIRTUALENV_PATH}"

        echo "Activate virtualenv"

        # shellcheck disable=SC1090
        . "${VIRTUALENV_ACTIVATE_FILEPATH}"
        ${PYTHON_FILEPATH} -m pip install --upgrade pip wheel setuptools

        # install command line tool
        ${PYTHON_FILEPATH} -m pip install "_tools/aos_cli"
        # ${PYTHON_FILEPATH} -m pip install -r "_tools/docker/aos_user_ubuntu2004/requirements.txt"
        # ${PYTHON_FILEPATH} -m pip install -r "_tools/docker/aos_dev_ubuntu2004/requirements.txt"

        # Workarounds
        ${PYTHON_FILEPATH} -m pip install pycryptodomex \
                           conan==1.59.0 \
                           gnupg \
                           rospkg \
                           poetry==1.8.3 \
                           colorlog \
                           mock \
                           tqdm \
                           robotframework==6.1.1 \
                           uv==0.5.4

        # other stuff that helps working
        ${PYTHON_FILEPATH} -m pip install ipdb ipython

        ${PYTHON_FILEPATH} -m pip install \
                           sphinx_rtd_theme \
                           breathe myst_parser \
                           sphinx_git \
                           sphinx_copybutton \
                           sphinx_panels \
                           sphinxcontrib_svg2pdfconverter \
                           sphinxcontrib_plantuml \
                           sphinx_needs \
                           esbonio==0.15 \
                           sphinx_autodoc_typehints \
                           sphinx-jsonschema \
                           sphinxcontrib-ditaa \
                           sphinx_design \
                           sphinxcontrib.moderncmakedomain \
                           sphinx_markdown_builder \
                           gcovr \
                           pandas \
                           jira \
                           junitparser \
                           matplotlib

        ${PYTHON_FILEPATH} -m pip install \
                           robotframework-assertion-engine==3.0.3 \
                           robotframework-browser==18.8.1 \
                           robotframework-databaselibrary==1.3.1 \
                           robotframework-robocop==4.0.1 \
                           robotframework-sshlibrary==3.8.1rc1 \
                           robotframework-tidy==4.5.0 \
                           robotframework==6.1.1 \
                           robotremoteserver==1.1.1 \
                           robotframework-jsonlibrary==0.5

        rfbrowser init

        deactivate

        # Create alias for vfc for local testing
        conan alias aos_vfc_dist/latest@aos/dev aos_vfc_dist/VFC-4.2.2@aos/aos
    )
}
