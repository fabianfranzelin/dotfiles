#!/usr/bin/env sh

aos_create_venv() {
    (
        cd "${HOME}/workspace/aos" || exit 1
        VIRTUALENV_NAME="aos"
        VIRTUALENV_PATH="${HOME}/.virtualenvs/${VIRTUALENV_NAME}"
        VIRTUALENV_ACTIVATE_FILEPATH="${HOME}/.virtualenvs/${VIRTUALENV_NAME}/bin/activate"

        echo "Create virtualenv ${VIRTUALENV_NAME}"
        rm -rf "${VIRTUALENV_PATH}"
        python3 -m venv "${VIRTUALENV_PATH}"

        echo "Activate virtualenv"

        # shellcheck disable=SC1090
        . "${VIRTUALENV_ACTIVATE_FILEPATH}"
        python3 -m pip install --upgrade pip wheel setuptools

        # install command line tool
        python3 -m pip install "_tools/aos_cli"
        # python3 -m pip install -r "_tools/docker/aos_user_ubuntu2004/requirements.txt"
        # python3 -m pip install -r "_tools/docker/aos_dev_ubuntu2004/requirements.txt"

        # # Workarounds
        python3 -m pip install pycryptodomex \
                conan==1.59.0 \
                gnupg \
                rospkg \
                poetry==1.7.0 \
                colorlog \
                mock \
                tqdm \
                robotframework

        # # other stuff that helps working
        python3 -m pip install ipdb ipython

        python3 -m pip install \
                sphinx_rtd_theme \
                breathe myst_parser \
                sphinx_git \
                sphinx_copybutton \
                sphinx_panels \
                sphinxcontrib_svg2pdfconverter \
                sphinxcontrib_plantuml \
                sphinx_needs \
                esbonio==0.15 \
                sphinx_autodoc_typehints \
                sphinx-jsonschema \
                sphinxcontrib-ditaa \
                sphinx_design \
                sphinxcontrib.moderncmakedomain \
                sphinx_markdown_builder \
                gcovr \
                pandas \
                jira \
                junitparser \
                matplotlib

        python3 -m pip install \
                robotframework-assertion-engine==1.0.0 \
                robotframework-browser==17.2.0 \
                robotframework-databaselibrary==1.3.1 \
                robotframework-robocop==4.0.1 \
                robotframework-sshlibrary==3.8.1rc1 \
                robotframework-tidy==4.5.0 \
                robotframework==6.1.1 \
                robotremoteserver==1.1.1 \
                robotframework-jsonlibrary==0.5

        rfbrowser init

        deactivate

        # Create alias for vfc for local testing
        conan alias aos_vfc_dist/latest@aos/dev aos_vfc_dist/VFC-4.2.2@aos/aos
    )
}
