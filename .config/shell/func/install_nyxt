#!/usr/bin/env sh

install_nyxt()
{
    SYSTEM_ARCH=$(dpkg --print-architecture)
    if [ "$SYSTEM_ARCH" != "amd64" ]; then
        echo "Skipping: system architecture is $SYSTEM_ARCH, not amd64."
        return 0
    fi

    NYXT_VERSION="4.0.0"

    (
        echo -e "${__COLOR_INFO}INFO: Installing Nyxt dependencies for Ubuntu 24.04${__COLOR_RESET}"
        sudo apt-get update
        sudo apt-get install -y \
            sbcl \
            libfixposix-dev \
            libfixposix4t64 \
            libwebkit2gtk-4.1-0 \
            glib-networking \
            gsettings-desktop-schemas \
            xclip \
            enchant-2 \
            libgtk-3-0 \
            libpangocairo-1.0-0 \
            libcairo2 \
            libgdk-pixbuf2.0-0 \
            libglib2.0-0 \
            libgirepository-1.0-1 \
            gstreamer1.0-gtk3 \
            gstreamer1.0-libav \
            gstreamer1.0-plugins-base \
            gstreamer1.0-plugins-good \
            gstreamer1.0-plugins-bad \
            gstreamer1.0-plugins-ugly \
            gstreamer1.0-x \
            gir1.2-gst-plugins-base-1.0 \
            gir1.2-gst-plugins-bad-1.0
    )

    (
        # Download and install Nyxt (extracted AppImage)
        TMP_NYXT_SRC=$(mktemp -d)
        cd "${TMP_NYXT_SRC}" || exit 1
        NYXT_SRC_FILE_NAME="Linux-Nyxt-x86_64.tar.gz"
        NYXT_APPIMAGE="Nyxt-x86_64.AppImage"
        NYXT_INSTALL_DIR="${HOME}/.local/lib/nyxt"

        echo -e "${__COLOR_INFO}INFO: Downloading Nyxt v${NYXT_VERSION}${__COLOR_RESET}"
        wget -q "https://github.com/atlas-engineer/nyxt/releases/download/${NYXT_VERSION}/${NYXT_SRC_FILE_NAME}"
        tar -xf "${NYXT_SRC_FILE_NAME}"
        chmod +x "${NYXT_APPIMAGE}"

        # Extract AppImage to avoid FUSE/sandbox issues
        ./"${NYXT_APPIMAGE}" --appimage-extract > /dev/null 2>&1

        # Install extracted contents
        rm -rf "${NYXT_INSTALL_DIR}"
        mv squashfs-root "${NYXT_INSTALL_DIR}"

        # Create launcher script
        cat > "${HOME}/.local/bin/nyxt" << 'LAUNCHER'
#!/usr/bin/env sh
export APPDIR="$HOME/.local/lib/nyxt"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$LD_LIBRARY_PATH"
export PATH="$APPDIR/usr/bin:$PATH"

# Disable Chromium SUID sandbox — cl-electron-server (embedded AppImage) can't
# have root-owned chrome-sandbox in a user directory.
export ELECTRON_DISABLE_SANDBOX=1

exec "$HOME/.local/lib/nyxt/AppRun" "$@"
LAUNCHER
        chmod +x "${HOME}/.local/bin/nyxt"

        rm -rf "${TMP_NYXT_SRC}"
    )

    (
        # Install extensions
        NYXT_EXTENSION_PATH="${HOME}/.local/share/nyxt/extensions"
        mkdir -p "${NYXT_EXTENSION_PATH}"

        NYXT_SEARCH_ENGINES="${NYXT_EXTENSION_PATH}/nx-search-engines"
        if [ ! -d "${NYXT_SEARCH_ENGINES}" ]; then
            git clone https://github.com/aartaka/nx-search-engines "${NYXT_SEARCH_ENGINES}"
        else
            cd "${NYXT_SEARCH_ENGINES}" || exit 1
            git pull
        fi
    )

    echo -e "${__COLOR_INFO}INFO: Nyxt ${NYXT_VERSION} installed successfully.${__COLOR_RESET}"
    echo -e "${__COLOR_INFO}INFO: For best performance, ensure hardware acceleration is available:${__COLOR_RESET}"
    echo -e "${__COLOR_INFO}  - GPU drivers installed (mesa-utils for verification: glxinfo | grep renderer)${__COLOR_RESET}"
    echo -e "${__COLOR_INFO}  - Set WEBKIT_DISABLE_COMPOSITING_MODE=1 if you experience rendering issues${__COLOR_RESET}"
}
