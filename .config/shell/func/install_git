#!/usr/bin/env bash
# shell: all

generate_git_credentials()
{
    local credentials_file

    credentials_file="${HOME}/.config/git/config.$(hostname).personal-credentials"

    echo "Generating git credentials..."

    # Start with header
    echo -n "" > "${credentials_file}"
    {
        printf "# Auto-generated by generate_git_credentials - DO NOT EDIT\n";
        printf "# Regenerate with: generate_git_credentials\n";
        printf "# Generated on: %s\n" "$(date)"
    } >> "${credentials_file}"

    # Helper function to add a url rewrite rule
    # Args: $1 = comment, $2 = username, $3 = token, $4 = base_url, $5 = path_prefix (optional)
    add_url_rewrite() {
        local comment="$1"
        local user="$2"
        local tok="$3"
        local base_url="$4"
        local path_prefix="${5:-}"

        {
            printf "# %s\n" "${comment}";
            printf "[url \"https://%s:%s@%s/%s\"]\n" "${user}" "${tok}" "${base_url}" "${path_prefix}";
            printf "    insteadOf = https://%s/%s\n" "${base_url}" "${path_prefix}";
        } >> "${credentials_file}"
    }

    local has_credentials=0

    # Check if `pass` and the password store directory are available. If not,
    # only emit warnings and skip any password-store lookups so CI doesn't fail
    # when the pass tool or store is not present.
    local pass_available=0
    if command -v pass >/dev/null 2>&1; then
        local password_store_dir
        password_store_dir="${PASSWORD_STORE_DIR:-${HOME}/.password-store}"
        if [[ -d "${password_store_dir}" ]]; then
            pass_available=1
        else
            echo "Warning: Password store directory '${password_store_dir}' not found - skipping password-store lookups" >&2
        fi
    else
        echo "Warning: 'pass' command not found - skipping password-store lookups" >&2
    fi

    # Helper: attempt to add credentials from pass store
    # Args: $1 = label, $2 = pass username path, $3 = pass token path template (use {user} for username), $4 = base_url, $5 = path_prefix template (use {user} for username)
    try_add_credential() {
        local label="$1"
        local user_path="$2"
        local token_path_tpl="$3"
        local base_url="$4"
        local prefix_tpl="${5:-}"

        local user tok token_path prefix
        user=$(pass "${user_path}" 2>/dev/null)
        if [[ -z "${user}" ]]; then
            echo "Warning: No entry in pass store for '${user_path}' - skipping ${label}" >&2
            return 0
        fi

        token_path="${token_path_tpl//\{user\}/${user}}"
        tok=$(pass "${token_path}" 2>/dev/null)
        if [[ -z "${tok}" ]]; then
            echo "Warning: No entry in pass store for '${token_path}' - skipping ${label}" >&2
            return 0
        fi

        prefix="${prefix_tpl//\{user\}/${user}}"
        add_url_rewrite "${label}" "${user}" "${tok}" "${base_url}" "${prefix}"
        has_credentials=1
    }

    # Add personal GitHub credentials (optional - skipped if not in pass store).
    # Only attempt to read from the pass store if it is available; otherwise
    # we've already warned and will skip silently.
    if [[ "${pass_available}" -eq 1 ]]; then
        try_add_credential \
            "GitHub: github.com (personal)" \
            "usernames/public@github" \
            "tokens/{user}@github.com" \
            "github.com" \
            "{user}/"
    fi

    if [[ "${has_credentials}" -eq 0 ]]; then
        echo "Warning: No git credentials were generated (no matching entries in pass store)" >&2
    fi

    # Set restrictive permissions (owner read/write only)
    chmod 600 "${credentials_file}"

    echo "Git credentials written to ${credentials_file}"
}

install_git()
{
    sudo apt-get install -y \
        git \
        git-lfs

    #------------------------------------------------------------------------------#
    # Generate credentials file from pass
    generate_git_credentials

    # Install github command line tool
    (
        sudo mkdir -p -m 755 /etc/apt/keyrings
        out=$(mktemp) && wget -nv -O"$out" https://cli.github.com/packages/githubcli-archive-keyring.gpg
        cat "$out" | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
        sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
        sudo mkdir -p -m 755 /etc/apt/sources.list.d
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
        sudo apt update
        sudo apt install gh -y
    )
}
