#!/usr/bin/env sh

generate_git_credentials()
{
    local hostname
    local credentials_file
    local token
    local username

    hostname=$(hostname)
    credentials_file="${DOTFILES}/.config/git/config.${hostname}.credentials"

    echo "Generating git credentials for ${hostname}..."

    # Start with header
    echo -n "" > "${credentials_file}"
    {
        printf "# Auto-generated by generate_git_credentials - DO NOT EDIT\n";
        printf "# Regenerate with: generate_git_credentials\n";
        printf "# Generated on: %s\n" "$(date)"
    } >> "${credentials_file}"

    # Helper function to add a url rewrite rule
    # Args: $1 = comment, $2 = username, $3 = token, $4 = base_url, $5 = path_prefix (optional)
    add_url_rewrite() {
        local comment="$1"
        local user="$2"
        local tok="$3"
        local base_url="$4"
        local path_prefix="${5:-}"

        {
            printf "# %s\n" "${comment}";
            printf "[url \"https://%s:%s@%s/%s\"]\n" "${user}" "${tok}" "${base_url}" "${path_prefix}";
            printf "    insteadOf = https://%s/%s\n" "${base_url}" "${path_prefix}";
        } >> "${credentials_file}"
    }

    case "${hostname}" in
        FEWI-C-0007J)
            # GitHub: public
            username=$(pass usernames/public@github 2>/dev/null)
            token=$(pass tokens/${username}@github.com 2>/dev/null)
            if [[ -n "${username}" && -n "${token}" ]]; then
                add_url_rewrite "GitHub: github.com (public)" "${username}" "${token}" "github.com" "${username}/"
            else
                echo "Warning: Missing credentials for ${username}@github.com" >&2
            fi

            # GitHub: PACE
            username=$(pass usernames/pace@github 2>/dev/null)
            token=$(pass tokens/${username}@github.com 2>/dev/null)
            if [[ -n "${username}" && -n "${token}" ]]; then
                add_url_rewrite "GitHub: ${username} (PACE-INT)" "${username}" "${token}" "github.com" "PACE-INT/"
                add_url_rewrite "GitHub: ${username} (personal)" "${username}" "${token}" "github.com" "${username}/"
            else
                echo "Warning: Missing credentials for ${username}@github.com" >&2
            fi

            # Bosch: github.boschdevcloud.com
            username=$(pass usernames/bosch 2>/dev/null)
            token=$(pass tokens/${username}@github.boschdevcloud.com 2>/dev/null)
            if [[ -n "${username}" && -n "${token}" ]]; then
                add_url_rewrite "Bosch: github.boschdevcloud.com" "${username}" "${token}" "github.boschdevcloud.com"
            else
                echo "Warning: Missing credentials for ${username}@github.boschdevcloud.com" >&2
            fi

            # Bosch: sourcecode01.de.bosch.com
            username=$(pass usernames/bosch 2>/dev/null)
            token=$(pass tokens/${username}@sourcecode01.de.bosch.com 2>/dev/null)
            if [[ -n "${username}" && -n "${token}" ]]; then
                add_url_rewrite "Bosch: sourcecode01.de.bosch.com" "${username}" "${token}" "sourcecode01.de.bosch.com"
            else
                echo "Warning: Missing credentials for ${username}@sourcecode01.de.bosch.com" >&2
            fi

            # Bosch: sourcecode.socialcoding.bosch.com
            username=$(pass usernames/bosch 2>/dev/null)
            token=$(pass tokens/${username}@sourcecode.socialcoding.bosch.com 2>/dev/null)
            if [[ -n "${username}" && -n "${token}" ]]; then
                add_url_rewrite "Bosch: sourcecode.socialcoding.bosch.com" "${username}" "${token}" "sourcecode.socialcoding.bosch.com"
            else
                echo "Warning: Missing credentials for ${username}@sourcecode.socialcoding.bosch.com" >&2
            fi
            ;;

        *)
            echo "No credential configuration defined for hostname: ${hostname}" >&2
            echo "# No credentials configured for this host" >> "${credentials_file}"
            ;;
    esac

    # Set restrictive permissions (owner read/write only)
    chmod 600 "${credentials_file}"

    echo "Git credentials written to ${credentials_file}"
}

install_git()
{
    sudo apt-get install -y \
        git \
        git-lfs

    #------------------------------------------------------------------------------#
    # Hack: setup workstation specific config for git using extra symlink
    (
        cd "${DOTFILES}/.config/git" || exit 1
        TARGET_GIT_CONFIG="config.$(hostname)"
        if [ -f "${TARGET_GIT_CONFIG}" ]; then
            ln -s -f "${TARGET_GIT_CONFIG}" "config.workstation"
        else
            echo -e "${__COLOR_INFO}No specific git configuration for $(hostname) available. Using the default one.${__COLOR_RESET}"
            ln -s -f "config.default" "config.workstation"
        fi
    )

    #------------------------------------------------------------------------------#
    # Generate credentials file from pass
    generate_git_credentials

    # Install github command line tool
    (
        sudo mkdir -p -m 755 /etc/apt/keyrings
        out=$(mktemp) && wget -nv -O"$out" https://cli.github.com/packages/githubcli-archive-keyring.gpg
        cat "$out" | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
        sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
        sudo mkdir -p -m 755 /etc/apt/sources.list.d
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
        sudo apt update
        sudo apt install gh -y
    )
}
