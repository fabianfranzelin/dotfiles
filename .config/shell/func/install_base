#!/usr/bin/env bash

install_apt_packages() {
    sudo apt-get install -y \
        xclip \
        xsel \
        wl-clipboard \
        locate \
        apt-transport-https \
        python3-pyqt5 \
        zsh \
        direnv \
        openjdk-17-jdk \
        zip \
        curl \
        wget \
        tar \
        bzip2 \
        unzip \
        compton \
        nitrogen \
        dmenu \
        vim \
        ccache \
        gnuplot \
        pass \
        gnupg \
        terminator \
        fzf \
        htop \
        ssh \
        sshpass \
        dos2unix \
        openssl \
        libssl-dev \
        scons \
        latexmk \
        texlive-base \
        texlive-science \
        texlive-bibtex-extra \
        texlive-lang-german \
        texlive-luatex \
        texlive-latex-extra \
        cm-super \
        biber \
        doxygen \
        evince \
        gcovr \
        xdg-utils \
        libgraphviz-dev \
        gnupg2 \
        ncdu \
        p7zip-full \
        ripgrep \
        flameshot \
        ninja-build \
        build-essential \
        texinfo \
        cloc \
        locales-all

    if ( __is_wsl )
    then
        # install wslview for xdg-open so that firefox calls are
        # forwarded to host system
        sudo apt-get install -y \
            wslu
    fi

    # install terminal emulator
    sudo snap install --classic ghostty || true

    # install gtk tools
    if ( __is_linux )
    then
        sudo apt-get install -y \
            vlc \
            firefox \
            eog
    fi

    # install dependencies for vscode
    if ( __is_linux )
    then
        # note that vscode is mounted from Windows in WSL and not
        # installed via apt. Ignore when code cannot be found
        sudo apt-get install -y code || true
        if command -v snap > /dev/null
        then
            sudo snap install --classic code || true
        fi
    fi
}

install_python_packages() {
    sudo apt-get install -y \
        python3-pip

    # Update python setuptools to latest release from pypi
    python3 -m pip install --upgrade \
        pip \
        wheel \
        setuptools

    # Install uv as default package manager for Python
    python3 -m pip install --upgrade \
        uv

    # additional python dependencies
    python3 -m pip install --upgrade \
        virtualenv \
        ptvsd \
        black \
        isort \
        yamllint \
        mdformat \
        cmake \
        cmake_language_server \
        "python-lsp-server[all]" \
        pylsp-mypy \
        python-lsp-black \
        esbonio==0.16.4 \
        robotframework-tidy \
        ipython \
        gitpython \
        pytest \
        jupyter \
        uv \
        beautysh \
        robotframework-robocop==4.2.2 \
        debugpy
}

install_packages_manually() {
    # install pandoc
    PANDOC_VER="3.8.2"
    SYSTEM_ARCH=$(dpkg --print-architecture)
    PANDOC_BIN="pandoc-${PANDOC_VER}-1-${SYSTEM_ARCH}.deb"
    PANDOC_URL="https://github.com/jgm/pandoc/releases/download/${PANDOC_VER}/${PANDOC_BIN}"
    (

        TEMP_DIR=$(mktemp -d)
        cd "${TEMP_DIR}" || exit 1
        wget "${PANDOC_URL}"
        sudo dpkg -i "${PANDOC_BIN}"
    )

    # install gdb
    GDB_NAME="gdb-16.1"
    GDB_PATH="${HOME}/.local/share/${GDB_NAME}"
    sudo apt-get install libmpc-dev -y
    if [ ! -d "${GDB_PATH}" ]
    then
        (
            TEMP_DIR=$(mktemp -d)
            cd "${TEMP_DIR}" || exit 1
            wget "https://sourceware.org/pub/gdb/releases/${GDB_NAME}.tar.xz"
            tar -xf "${GDB_NAME}.tar.xz"
            cd "${GDB_NAME}" || exit 1
            ./configure --prefix="${GDB_PATH}"
            make CXXFLAGS="-static-libstdc++"
            make install

            # use update-alternatives to manage the binaries
            [ -f "/usr/bin/gdb" ] && sudo mv "/usr/bin/gdb" "/usr/bin/gdb.backup"
            sudo update-alternatives --install "/usr/bin/gdb" gdb "${GDB_PATH}/bin/gdb" 100
            sudo update-alternatives --install "/usr/bin/gdb" gdb "/bin/gdb" 50
            sudo update-alternatives --auto gdb
        )
    fi

    # install draw.io
    DRAW_IO_VER="28.2.5"
    DRAW_IO_BIN="drawio-${SYSTEM_ARCH}-${DRAW_IO_VER}.deb"
    DRAW_IO_URL="https://github.com/jgraph/drawio-desktop/releases/download/v${DRAW_IO_VER}/${DRAW_IO_BIN}"
    (
        TEMP_DIR=$(mktemp -d)
        cd "${TEMP_DIR}" || exit 1
        wget "${DRAW_IO_URL}"
        sudo dpkg -i "${DRAW_IO_BIN}"
    )

    # install jetbrains mono nl font
    JETBRAINS_MONO_VER="2.304"
    JETBRAINS_MONO_NAME="JetBrainsMono-${JETBRAINS_MONO_VER}.zip"
    JETBRAINS_MONO_URL="https://download.jetbrains.com/fonts/${JETBRAINS_MONO_NAME}"
    (
        # Download the font
        TEMP_DIR=$(mktemp -d)
        cd "${TEMP_DIR}" || exit 1
        wget "${JETBRAINS_MONO_URL}"
        unzip "${JETBRAINS_MONO_NAME}"
        cd "fonts/ttf" || exit

        # Install it into home director
        FONTS_DIR="${HOME}/.local/share/fonts"
        mkdir -p "${FONTS_DIR}"
        yes | cp -rf *.ttf "${FONTS_DIR}"

        # Update font cache
        sudo fc-cache -f -v
    )
}

install_base() {
    echo -e "${__COLOR_INFO}INFO: Installing minimal required packages for setup...${__COLOR_RESET}"
    install_apt_packages
    install_python_packages
    install_packages_manually
}
