        dos2unix \
        openssl \
        libssl-dev \
        scons \
        latexmk \
        texlive-base \
        texlive-fonts-extra \
        texlive-science \
        texlive-bibtex-extra \
        texlive-lang-german \
        texlive-luatex \
        texlive-latex-extra \
        texlive-latex-recommended \
        texlive-extra-utils \
        inkscape \
        cm-super \
        biber \
        doxygen \
        evince \
        gcovr \
        xdg-utils \
        libgraphviz-dev \
        gnupg2 \
        ncdu \
        p7zip-full \
        ripgrep \
        flameshot \
        ninja-build \
        build-essential \
        texinfo \
        cloc \
        locales-all \
        bluez \
        blueman \
        mosh \
        protobuf-compiler \
        pavucontrol \
        caffeine \
        golang \
        gsimplecal \
        meld \
        autorandr

    # Create save path for flameshot
    mkdit -p "${HOME}/Pictures/Screenshots"

    # required to restart raspi automatically on very high load
    sudo apt-get install watchdog -y || true
    # This is required by the ssh config to identify whether pauline
    # is reachable or not.
    sudo apt-get install net-tools -y || true

    # Close windows via shortcut for xfce4
    sudo apt-get install xdotools -y || true

    # List of packages with specific versions
    packages=(
        "openjdk-17-jdk"
        "openjdk-25-jdk"
    )

    # Iterate over the list and install each package
    for package in "${packages[@]}"; do
        sudo apt install "$package" -y || true
    done

    if ( __is_wsl )
    then
        # install wslview for xdg-open so that firefox calls are
        # forwarded to host system
        sudo apt-get install -y \
            wslu
    fi

    # install gtk tools
    if ( __is_linux )
    then
        sudo apt-get install -y \
            vlc \
            eog
        sudo apt-get install firefox -y || {
            # Only install firefox-esr when the latest greatest is not
            # available
            sudo apt-get install firefox-esr -y || true
        }
    fi

    # install dependencies for vscode
    if ( __is_linux )
    then
        # note that vscode is mounted from Windows in WSL and not
        # installed via apt. Ignore when code cannot be found
        sudo apt-get install -y code || true
        if command -v snap > /dev/null
        then
            sudo snap install --classic code || true
        fi
    fi
}

