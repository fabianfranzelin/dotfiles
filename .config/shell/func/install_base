install_packages_manually() {
    __install_load_versions

    local SYSTEM_ARCH
    SYSTEM_ARCH=$(__install_dpkg_arch)
    local UNAME_ARCH
    UNAME_ARCH=$(__install_uname_arch)

    # --- Ghostty terminal ---
    # On Ubuntu 24.04 do a manual install (some snaps/apt packages may be broken).
    # For other systems try snap first then apt as fallback.
    local IS_UBUNTU=false UBUNTU_VERSION=""
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        if [ "${ID}" = "ubuntu" ] || echo "${NAME:-}" | grep -qi ubuntu; then
            IS_UBUNTU=true
            UBUNTU_VERSION="${VERSION_ID:-}"
        fi
    fi

    if ${IS_UBUNTU} && [ "${UBUNTU_VERSION}" = "24.04" ]; then
        install_github_deb \
            "https://github.com/mkasberg/ghostty-ubuntu/releases/download/${GHOSTTY_VER}-0-ppa1/ghostty_${GHOSTTY_VER}-0.ppa1_${SYSTEM_ARCH}_24.04.deb" \
            "ghostty" "${GHOSTTY_VER}"
    else
        sudo snap install --classic ghostty || true
        sudo apt-get install ghostty -y || true
    fi

    # --- Pandoc ---
    install_github_deb \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VER}/pandoc-${PANDOC_VER}-1-${SYSTEM_ARCH}.deb" \
        "pandoc" "${PANDOC_VER}"

    # --- GDB (build from source) ---
    local GDB_NAME="gdb-${GDB_VER}"
    local GDB_PATH="${HOME}/.local/share/${GDB_NAME}"
    sudo apt-get install libmpc-dev -y
    if [ ! -d "${GDB_PATH}" ]; then
        (
            TEMP_DIR=$(mktemp -d)
            cd "${TEMP_DIR}" || exit 1
            wget "https://sourceware.org/pub/gdb/releases/${GDB_NAME}.tar.xz"
            tar -xf "${GDB_NAME}.tar.xz"
            cd "${GDB_NAME}" || exit 1
            ./configure --prefix="${GDB_PATH}"
            make CXXFLAGS="-static-libstdc++"
            make install

            [ -f "/usr/bin/gdb" ] && sudo mv "/usr/bin/gdb" "/usr/bin/gdb.backup"
            sudo update-alternatives --install "/usr/bin/gdb" gdb "${GDB_PATH}/bin/gdb" 100
            sudo update-alternatives --install "/usr/bin/gdb" gdb "/bin/gdb" 50
            sudo update-alternatives --auto gdb
        )
    fi

    # --- Draw.io ---
    install_github_deb \
        "https://github.com/jgraph/drawio-desktop/releases/download/v${DRAW_IO_VER}/drawio-${SYSTEM_ARCH}-${DRAW_IO_VER}.deb" \
        "drawio" "${DRAW_IO_VER}"

    # --- JetBrains Mono font ---
    local FONTS_DIR="${HOME}/.local/share/fonts"
    if [ ! -d "${FONTS_DIR}" ] || ! ls "${FONTS_DIR}"/JetBrainsMono*.ttf &>/dev/null; then
        local JETBRAINS_MONO_NAME="JetBrainsMono-${JETBRAINS_MONO_VER}.zip"
        (
            TEMP_DIR=$(mktemp -d)
            cd "${TEMP_DIR}" || exit 1
            wget -q "https://download.jetbrains.com/fonts/${JETBRAINS_MONO_NAME}"
            unzip -q "${JETBRAINS_MONO_NAME}"
            mkdir -p "${FONTS_DIR}"
            cp -f fonts/ttf/*.ttf "${FONTS_DIR}"
            sudo fc-cache -f -v
        )
    else
        echo -e "${__COLOR_INFO:-}INFO: JetBrains Mono already installed, skipping.${__COLOR_RESET:-}"
    fi

    # --- Buildifier (bazel formatter) ---
    install_github_binary \
        "https://github.com/bazelbuild/buildtools/releases/download/v${BUILDIFIER_VER}/buildifier-linux-${UNAME_ARCH}" \
        "buildifier" "${BUILDIFIER_VER}"

    # --- Bazelisk (bazel launcher) ---
    install_github_binary \
        "https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VER}/bazelisk-linux-${UNAME_ARCH}" \
        "bazel" "${BAZELISK_VER}"

    # --- Starpls (starlark language server) ---
    local STARPLS_ARCH
    case "$(uname -m)" in
        x86_64)         STARPLS_ARCH="linux-amd64" ;;
        aarch64|arm64)  STARPLS_ARCH="linux-aarch64" ;;
        *)              echo "Unsupported architecture for starpls"; return 1 ;;
    esac
    install_github_binary \
        "https://github.com/withered-magic/starpls/releases/download/v${STARPLS_VER}/starpls-${STARPLS_ARCH}" \
        "starpls" "${STARPLS_VER}"

    # Install Opencode
    # curl -fsSL https://opencode.ai/install | bash

    # Install Ollama
    # curl -fsSL https://ollama.com/install.sh | sh

    # Install Goose
    # curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh | bash

    # Install qodo
    # npm install -g @qodo/command

    # Install azure sdk for ai
    # npm install -g @ai-sdk/azure
}

configure_gnupg() {
    link_host_config "${DOTFILES}/.gnupg" "gpg.conf" "gpg.conf" "gpg.conf.default"
}

configure_elora() {
    # https://get.vial.today/manual/linux-udev.html
    # shellcheck disable=SC2034
    USER_ID=$(id -g)
    sudo --preserve-env=USER_GID sh -c 'echo "KERNEL==\"hidraw*\", SUBSYSTEM==\"hidraw\", ATTRS{serial}==\"*vial:f64c2b3c*\", MODE=\"0660\", GROUP=\"$USER_GID\", TAG+=\"uaccess\", TAG+=\"udev-acl\"" > /etc/udev/rules.d/59-vial.rules && udevadm control --reload && udevadm trigger'
}

install_base() {
    install_helpers
    echo -e "${__COLOR_INFO}INFO: Installing minimal required packages for setup...${__COLOR_RESET}"
    install_apt_packages
    install_python_packages
    install_packages_manually
    configure_gnupg

    if [ "$(hostname)" = "thinkpad" ]
    then
        configure_elora
    fi
}

# zsh autoload compatibility: execute on first load
if [[ -n "${ZSH_VERSION:-}" ]] && [[ "${funcstack[1]:-}" == "install_base" ]]; then
    install_base "$@"
fi
