aos_run_container() {
    docker run -it --rm \
           --net host \
           -e http_proxy \
           -e https_proxy \
           -e USER \
           -e BOSCH_USER \
           -e BITBUCKET_TOKEN \
           -e ARTIFACTORY_APIKEY \
           -e DISPLAY \
           -e CONAN_USER_HOME=/tmp/user/ \
           -v $HOME/.conan:/tmp/user/.conan \
           -u $(id -u):$(id -g) \
           -v "${HOME}/workspace/aos_base":/tmp/user/aos_base \
           -v ${HOME}/.qnx:/tmp/user/.qnx \
           -v ${HOME}/.flexlmrc:/tmp/user/.flexlmrc \
           -v /var/tmp/ccache:/var/tmp/ccache \
           --shm-size 4g \
           --workdir /tmp/user/aos_base \
           -v "${HOME}/.bash_history:/tmp/user/.bash_history" \
           -v "/tmp/.X11-unix:/tmp/.X11-unix" \
           -v "${XAUTHORITY}:/home/frf2lr/.Xauthority" \
           -e "DEBIAN_FRONTEND=noninteractive" \
           rb-dtr.de.bosch.com/aos/aos_dev_osd6
}
