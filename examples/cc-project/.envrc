# -*- mode: envrc-file -*-
# Pure Nix development shell for cc-project (see README.org).

if ! has nix; then
    log_status "nix not found in PATH; skipping cc-project dev shell"
    return 0
fi

use flake

# Pure environment: keep only Nix store entries in PATH.
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep '^/nix/store/' | paste -sd: -)
export PATH

# Drop host library/include paths that could leak into builds.
unset LD_LIBRARY_PATH CPATH LIBRARY_PATH PKG_CONFIG_PATH

# Use the right bazel version
export USE_BAZEL_VERSION="9.2.0"

# Host CA bundle (contains the corporate proxy CAs).
host_ca=/etc/ssl/certs/ca-certificates.crt
export SSL_CERT_FILE=$host_ca
export NIX_SSL_CERT_FILE=$host_ca
export GIT_SSL_CAINFO=$host_ca

# Java trust store for Bazel's embedded JDK, rebuilt when the host bundle changes.
truststore="$PWD/.direnv/cacerts.p12"
if [ ! -f "$truststore" ] || [ "$host_ca" -nt "$truststore" ]; then
    mkdir -p "$PWD/.direnv"
    openssl pkcs12 -export -nokeys \
            -in "$host_ca" \
            -jdktrust anyExtendedKeyUsage \
            -passout pass:changeit \
            -out "$truststore" \
        || log_error "failed to build Bazel trust store"
fi
export BAZEL_NIX_TRUSTSTORE=$truststore

watch_file flake.nix flake.lock packages.nix bazel.nix nix.bazelrc
